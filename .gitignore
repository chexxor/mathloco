# build output
dist/
.output/
.vercel/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# CloudFlare
.wrangler/

# Database ORM
# Note: no trailing slash. The drizzle configs load this FILE (scripts/drizzle-config.ts) and it
# holds CLOUDFLARE_D1_API_TOKEN; `.drizzle.env/` would only match a directory and leave the
# token committable.
.drizzle.env

# Astro
.astro/

# Skill installs regenerate this mirror of .agents/skills for other agent CLIs.
.hermes/

# Environment variables
.env
.env.*
!.env.example
.dev.vars

# Local database files
*.sqlite
*.sqlite3
*.db

# API keys and secrets
*.pem
*.key

# Dev Notes
.notes/

# Design pass (phase 3): the evidence base IS tracked (specimens, probes, machine records, the
# contrast outputs DESIGN.md cites) — see .design/records/0009-design-evidence-is-tracked.md.
# Three things are not:
#  - candidate font binaries: re-fetchable from @fontsource, and the ratified faces arrive as npm
#    packages in design-apply, so a woff2 here is a scratch copy, not evidence;
#  - harness scratch: screenshots the probe harness writes on every run;
#  - scratch files.
.design/fonts/*.woff2
.design/grill/.probe-shot-*.png
.design/tmp-*

# Machine-local pi agent state: a local-model endpoint (and its key) can land
# here, so it is host-specific like durig.config.json and never committed.
.pi/
