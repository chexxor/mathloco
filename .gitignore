# build output
dist/
.output/
.vercel/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS-specific files
.DS_Store

# CloudFlare
.wrangler/

# Database ORM
# Note: no trailing slash. The drizzle configs load this FILE (scripts/drizzle-config.ts) and it
# holds CLOUDFLARE_D1_API_TOKEN; `.drizzle.env/` would only match a directory and leave the
# token committable.
.drizzle.env

# Astro
.astro/

# Skill installs regenerate this mirror of .agents/skills for other agent CLIs.
.hermes/

# Environment variables
.env
.env.*
!.env.example
.dev.vars

# Content placeholders. `src/content.local/` holds build-time overlays of `src/content.json` used to make a
# REVIEW build (measured shot-cards in the reserved photo places). Only `src/content.local.example.json` is
# tracked: nothing tracked may switch a placeholder on, and scripts/check-content.mjs fails any built page
# carrying a `data-placeholder` fill, so a review-only state cannot reach the apex the way .dev.vars cannot
# leak a secret. A DIRECTORY, deliberately: `import.meta.glob('../content.local.json')` was measured to also
# match `content.local.example.json`, which would have made the tracked example the override.
src/content.local/

# Local database files
*.sqlite
*.sqlite3
*.db

# API keys and secrets
*.pem
*.key

# Dev Notes
.notes/

# Design pass. The durable half is TRACKED in `design/` (no dot): the gates and their harness, the
# probes behind every number DESIGN.md quotes, the specimens, the machine records — see
# design/README.md and design/records/0009-design-evidence-is-tracked.md.
# `.design/` (with the dot) is scratch, and only these four things are ignored:
#  - candidate font binaries: re-fetchable from @fontsource, and the ratified faces arrive as npm
#    packages in design-apply, so a woff2 there is a scratch copy, not evidence;
#  - what the render gate measured on this machine, rewritten on every run — the gate's PASS/FAIL line
#    is the report; those are the raw numbers behind it;
#  - scratch files (tmp-*);
#  - harness scratch. page-measure/probe write .probe-shot-<w>.png, .measured-*.html and rendered-*.html
#    NEXT TO whatever they probe, which can be a specimen inside design/ — so these are basename
#    patterns with no leading directory, which keeps both directories clean.
.design/fonts/*.woff2
.design/render/
.design/tmp-*
# The operator's source figure, fetched from Meetup's CDN to read its geometry. Meetup's images are not
# ours to republish on another domain (.notes/asset-sources.md), so the pixels stay out of git even though the
# reading of them (DESIGN.md's mark rules, D126) is tracked.
.design/mark-src/
# Hand-made snapshots of source files, kept while editing (`.design/keep/*.astro`). The build reads `src/`,
# so a copy here is inert: editing it changes nothing, and a stale copy is a trap for the next session.
# Durable versions of these files are in git; this is a scratch duplicate, ignored so `git status` stays
# honest and nobody mistakes it for a second source tree.
.design/keep/
# Ad hoc measurement dumps written by hand at the shell (verify-out.txt, mark-geometry-320.txt). The durable
# form of any number worth keeping is a JSON under design/ that a script writes and a doc cites.
.design/*.txt
.probe-shot-*.png
.measured-*.html
rendered-*.html

# Machine-local pi agent state: a local-model endpoint (and its key) can land
# here, so it is host-specific like durig.config.json and never committed.
.pi/
