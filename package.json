{
  "name": "minneapolis-math-book-club",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start:app": "astro dev",
    "start:functions": "wrangler pages dev dist",
    "build": "astro build",
    "preview": "astro dev --host",
    "astro": "astro",
    "check": "astro check",
    "check:sanitize": "tsx scripts/check-sanitize.ts",
    "db:generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit pull",
    "db:migrate:local": "wrangler d1 migrations apply d1-mathloco-prod-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply d1-mathloco-prod-db --remote",
    "db:migrate:preview": "wrangler d1 migrations apply --env preview d1-mathloco-preview-db --remote",
    "db:studio:local": "node scripts/find-db.js && drizzle-kit studio",
    "db:studio:preview": "source .drizzle.env && DB_ID='b58d56c1-6aa6-4108-a1c3-91b5e9dbbcb7' drizzle-kit studio",
    "db:studio:prod": "source .drizzle.env && DB_ID='4e997466-3b31-4a4d-8187-a1e24f6ab7a3' drizzle-kit studio",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@discordjs/rest": "^2.6.3",
    "@fontsource/pt-serif": "^5.3.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "discord-api-types": "^0.38.57",
    "drizzle-orm": "^0.45.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "sass": "^1.107.0",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
