{
  "name": "minneapolis-math-book-club",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start:app": "astro dev",
    "serve:dist": "astro build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run verify && wrangler deploy",
    "preview:deploy": "npm run verify && wrangler preview",
    "build": "astro build",
    "verify": "npm run check && npm run check:classes && npm run db:check && npm run check:sanitize && npm run check:cache && npm run audit:gate && npm run build && npm run check:deploy",
    "preview": "astro dev --host",
    "preview:workerd": "astro build && astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:sanitize": "tsx scripts/check-sanitize.ts",
    "check:classes": "tsx scripts/check-classes.ts",
    "check:discord": "tsx scripts/check-discord-access.ts",
    "check:ai": "tsx scripts/check-ai-model.ts",
    "check:deploy": "tsx scripts/check-deploy-target.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check --config drizzle.config.check.ts",
    "db:migrate:local": "wrangler d1 migrations apply d1-mathloco-prod-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply d1-mathloco-prod-db --remote",
    "db:migrate:preview": "wrangler d1 migrations apply --env preview d1-mathloco-preview-db --remote",
    "db:studio:local": "drizzle-kit studio",
    "db:studio:preview": "drizzle-kit studio --config drizzle.config.preview.ts",
    "db:studio:prod": "drizzle-kit studio --config drizzle.config.prod.ts",
    "db:pull:local": "drizzle-kit pull",
    "db:pull:preview": "drizzle-kit pull --config drizzle.config.preview.ts",
    "db:pull:prod": "drizzle-kit pull --config drizzle.config.prod.ts",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "audit:gate": "tsx scripts/audit-gate.ts",
    "cf:types": "wrangler types",
    "cf:secrets:list": "wrangler secret list",
    "cf:secrets:list:preview": "wrangler preview secret list",
    "cf:secrets:list:preview-base": "wrangler preview base-config secret list",
    "cf:kv:create": "wrangler kv namespace create SUMMARY_CACHE",
    "check:cache": "tsx scripts/check-summary-cache.ts",
    "assets:social": "node scripts/make-social-share.mjs",
    "probe:cpu": "node scripts/probe-config.mjs && wrangler deploy --config dist/server/wrangler.probe.json",
    "falsify:manifest": "node scripts/falsify-manifest-token.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@fontsource/pt-serif": "^5.3.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "drizzle-orm": "^0.45.4",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@discordjs/rest": "^2.6.3",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.3",
    "discord-api-types": "^0.38.57",
    "drizzle-kit": "^0.31.11",
    "sass": "^1.107.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true
  }
}
