# .drizzle.env.example - copy to .drizzle.env (gitignored) and fill in.
#
# Only one value here is a secret: CLOUDFLARE_D1_API_TOKEN. The account id and the two database
# ids are resource ids, not credentials, and the same database ids are already committed in
# wrangler.toml. They are repeated here only because drizzle-kit reads them under these names.
#
# The token: create one at https://dash.cloudflare.com/profile/api-tokens with permissions that
# cover D1 read/write on the account (Jobs > D1 > Edit, or the equivalent scoped permission), and
# restrict it to just d1-mathloco-prod-db and d1-mathloco-preview-db if the UI lets you. Do not
# use a Global API key. drizzle-kit's `d1-http` driver talks to the Cloudflare API directly.
CLOUDFLARE_D1_ACCOUNT_ID=your-account-id-run-npx-wrangler-whoami
CLOUDFLARE_D1_API_TOKEN=your-d1-token

# drizzle.config.prod.ts (db:studio:prod, db:pull:prod).
DB_ID=4e997466-3b31-4a4d-8187-a1e24f6ab7a3

# drizzle.config.preview.ts (db:studio:preview, db:pull:preview).
PREVIEW_DB_ID=b58d56c1-6aa6-4108-a1c3-91b5e9dbbcb7

# Optional. The local tools look for the local D1 file under .wrangler/state/v3/d1 and refuse to
# guess if more than one real database file is there (a second binding, or a second env). Set
# this to one of the files that `find .wrangler/state/v3/d1 -name '*.sqlite'` prints.
# LOCAL_D1_FILE=.wrangler/state/v3/d1/miniflare-D1DatabaseObject/some-hash.sqlite
