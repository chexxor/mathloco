---
export interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = seo.title, noindex = false } = Astro.props;
const robots = noindex ? 'noindex,nofollow' : 'index,follow';
import "@fontsource/pt-serif";
import "../styles/global.css";
import { seo } from "../config.json";
import Navigation from '../components/Navigation.astro';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={seo.canonical + seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={seo.title} />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />

    <title>{title}</title>

  </head>
  <body class="bg-paper text-ink">
    <Navigation />
    <slot />
    <style lang="scss" is:global>
      /* The theme colour is the token from src/styles/global.css (@theme --color-book-theme).
         src/config.json declares the same hex under `theme.color`, but nothing reads it, so this
         token is the source of truth. These rules used to hardcode a different blue (#3b82f6),
         so the only places a theme colour actually rendered disagreed with the colour the rest of
         the site declares. */
      ::selection {
        /* paper on ink = 12.02, asserted in .design/grill/contrast/gen-ratify-cfg.mjs. The retired
           amber pair measured 2.06, under the 4.5 bar; the amber is delta-OKLab 0.019 from Amazon
           orange #FF9900 (D82/D88), which is why the token goes, not just this rule. */
        background: var(--color-ink);
        color: var(--color-paper);
      }

      .love {
        display: inline-block;
        position: relative;
        top: 0.1em;
        transform: scale(0.9);
        animation: love 0.5s infinite linear alternate-reverse;
      }

      @keyframes love {
        to {
          transform: scale(1.1);
        }
      }

      /* The 404 page's link writes the `underline` utility. A GLOBAL class of the same name used
         to sit here: an amber highlighter bar with text-decoration: none, later in the cascade than
         the utility, so every "underline" on the site was painted amber and NOT underlined. It is the
         reason the class gate could not see the last amber write on the site — the appearance came
         from a <style> block, not a class. Utility wins now. */
    </style>
  </body>
</html>
