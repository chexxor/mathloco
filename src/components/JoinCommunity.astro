---
import PhotoSlot from './PhotoSlot.astro';
import config from '../config.json';
---

<section class="bg-paper py-16">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-heading font-extrabold text-ink">
        Join Our Community
      </h2>
      <p class="mt-4 text-lede leading-prose text-ink-2 font-body max-w-measure mx-auto">
        Connect with fellow math enthusiasts and join our monthly discussions
      </p>
    </div>

    <div class="mt-12 bg-panel rounded-card overflow-hidden">
      <div class="px-6 py-8 sm:p-10 sm:pb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-subhead font-semibold text-ink mb-4">
              Why Join Our Meetup Group?
            </h3>
            <ul class="space-y-4 text-body leading-prose text-ink-2 font-body">
              <li class="flex items-start">
                <span class="flex-shrink-0 h-6 w-6 text-ink">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="ml-3">Monthly in-person study sessions</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 h-6 w-6 text-ink">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="ml-3">Collaborative problem-solving</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 h-6 w-6 text-ink">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="ml-3">Network with math enthusiasts</span>
              </li>
            </ul>
          </div>

          <!-- PS-3, the join media column (round 10 ruling: reserve it now). `check:space` measures this column
               at 532x128 at 1240 and 310x245 at 390. Unlike the hero column this one is NOT spare air: its height
               is the call-to-action's own height, so a photo here is a GROWTH, not a reclamation - at the column's
               measured 532x128 it adds ~152px to the card (and `check:rhythm` says page height is not free). That
               is worth paying once a real photograph of this club exists; it is not worth paying for a stock one
               (D94). The call-to-action below stays whether or not the photo does: a photograph may add to the
               join path here, never replace it. `data-slot` is a probe handle: `check:space` and `npm run
               round10` re-measure the applied box instead of trusting this comment. -->
          <div data-slot="PS-3">
          <PhotoSlot
            slot="join"
            ratio="532 / 128"
            caption="the club mid-session, wide crop (532x128)"
          />
          <p class="text-body leading-prose text-ink-2 font-body mb-6">
            Sessions are posted on Meetup, where the calendar and the sign-up live. The discussion keeps
            going between meetings in the chat.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={config.URLs.meetupGroup}
              target="_blank"
              rel="noopener noreferrer"
              data-control="primary"
              class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
            >
              Join on Meetup
              <svg class="ml-2 -mr-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
            <a
              href={config.URLs.discordInvite}
              target="_blank"
              rel="noopener noreferrer"
              data-control="secondary"
              class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
            >
              Join the chat
            </a>
          </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>