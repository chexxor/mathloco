---
import config from '../config.json';
import Checkmark from './icons/Checkmark.astro';
---

<section class="bg-panel py-16">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-heading font-extrabold text-ink">
        Why Join Our Math Book Club?
      </h2>
      <p class="mt-4 text-lede leading-prose text-ink-2 font-body max-w-measure mx-auto">
        Discover the benefits of collaborative learning and mathematical exploration
      </p>
    </div>

    <div class="mt-16">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {/* Benefit Cards */}
        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Expert Guidance</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Learn from experienced mathematicians and educators who can help clarify complex concepts and provide valuable insights.
          </p>
        </div>

        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Collaborative Learning</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Work together with fellow math enthusiasts to solve challenging problems and develop deeper understanding through discussion.
          </p>
        </div>

        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Regular Meetups</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Sessions most months, on different mathematical topics, from number theory to abstract algebra.
          </p>
        </div>

        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Study Resources</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Access to curated learning materials, problem sets, and recommended readings to support your mathematical journey.
          </p>
        </div>

        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Diverse Community</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Connect with students, professionals, and hobbyists who share your passion for mathematics.
          </p>
        </div>

        <div class="bg-paper rounded-card p-6">
          <div class="flex items-center mb-4">
            <Checkmark />
            <h3 class="ml-3 text-lede font-semibold text-ink">Growth Mindset</h3>
          </div>
          <p class="text-body leading-prose text-ink-2 font-body">
            Develop problem-solving skills and mathematical thinking in a supportive, encouraging environment.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">

      <a
        href={`${config.URLs.meetupGroup}/join`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
        >Join Our Next Session</a
      >
    </div>
  </div>
</section>
