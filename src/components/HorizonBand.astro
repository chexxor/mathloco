---
import { Image } from 'astro:assets';
import euclid1903 from '../assets/photos/horizon-euclid1903.png';
import euler1910 from '../assets/photos/horizon-euler1910.png';
import radio1922 from '../assets/photos/horizon-radio1922.png';

/**
 * PS-5 — the horizon: three public-domain plates standing on one baseline between the club's reasons and
 * the schedule, where the page is emptiest by measurement.
 *
 * Why three and not one (this is the ruling the composition arrived at, 2026-11-03, round 14 option C -> F):
 * the archive serves a widest rung of `/img/1024/`, but that rung returns each leaf's *own* scan width — the
 * 1910 Euler leaf is 698x350 and the Byrne leaf 688x1004 (probed 2026-11-03; `/img/1600/`, `/img/2048/` and
 * `/img/full/` all return 404). A single-leaf band across the 1192px column is therefore a **1.68x upscale
 * that keeps 34% of the drawing** (`design/grill/round14/report.json`, `plates["band-mid"]`). Record 0023
 * answered that in advance: *"if a strip is ever wanted from the archive, compose it from several plates
 * rather than upscale one."* These three are each a whole leaf at **0.38–0.55x** of its native scan.
 *
 * What it costs, measured on the built page at the box this component ships (`npm run round14`, option
 * `shelf-lg`, 2026-11-03): page **+321px at 1240** and **+321 at 1024**, **+0 at 640 and 390** (the band was
 * `hidden` below `lg` then, and the phone kept the composition the operator ruled in round 14's phone question),
 * painted area **5.33% -> 7.47%** at 1240, and page chroma >= 0.08 **0.274% -> 0.255%** — three more plates
 * and the page gets *less* loud, because all three are colourless line work (0% at chroma >= 0.08 each).
 * @measured 2026-11-03 by npm run round14
 *
 * **The band is no longer desktop-only (D329, 2026-11-15, lifting D168's park).** The round-3 read asked for
 * 3-up from 900, 2-up from 640, 1-up below, and the re-measure prices what that costs on a phone: the band
 * adds **+332px at 1240** (the round's +321, the same box), **+472px at 640**, **+715px at 390** and
 * **+623px at 320**, so the phone page goes from 4045px to **4760px** at 390 — 18% taller, for three plates
 * stacked one per line at 346px wide (0.45x of the archive's own scan, so the hairlines survive). The rungs
 * are the read's; the *cost* is the number the operator has to weigh, and the cheaper rung is one class
 * (`hidden sm:block`, which pays +472 at 640 and nothing below). @measured 2026-11-15 by `node design/plates-price.mjs`
 * (plates painted: 382.6px x3 at 1240, 282px x2 +1 wrapped at 640, 346px x3 stacked at 390).
 *
 * The alt text comes from the source's own picture page (`insideoutlibrary.com/p/<id>`, which carries book,
 * year and leaf), plus the one thing measured about the drawing itself: it is line work, ink at 21.1% of
 * pixels and 0% named colour (`design/grill/round14/report.json`). Nothing here describes a drawing nobody
 * has checked — an alt invented from a slot's mood is the D92 defect class in a `alt` attribute.
 */
const plates = [
  {
    src: euclid1903,
    // Copied from the picture page's own words (`insideoutlibrary.com/p/<id>`), which labels this leaf and carries
    // its surrounding text: "Octahedron. Dodecahedron. Icosahedron. 30. A parallelepiped is a solid figure…".
    // What the drawing is was **guessed wrong here for an hour** (a "Book VI figure on a right triangle", inferred
    // from the book's title and the id's numbers) — an invented alt is the D92 defect class in an attribute.
    // 9 words, inside the 12-word cap `check:alt` enforces (D324); the citation lives in the caption.
    alt: 'Three solids drawn in line work: octahedron, dodecahedron, icosahedron',
    provenance: 'The elements of Euclid for the use of schools and colleges (1903), leaf 297',
  },
  {
    src: euler1910,
    // "euler1910" is our **slot key** from D149-2b (the line-work diagram that decision asked for), not a claim
    // about who drew it — the book is Slaught & Lennes 1910. The page's own text: "with center O tangent to the four
    // arcs as shown. Suggestion. Take X so that DX = XB. With centers A and B and radius AX draw arcs meeting at O."
    alt: 'Arcs cut from two centres, with a circle tangent to all four',
    provenance: 'Plane geometry, with problems and applications (Slaught & Lennes, 1910), leaf 122',
  },
  {
    src: radio1922,
    // The page's own caption text: "Antenna Current in radiotelephony Transmitting the Sound of a as in father.
    // Modulates a radio-frequency Wave which can be received with Simple Detector … Beat Reception is Required."
    alt: 'A radio-frequency wave carrying a spoken sound, caught by a detector',
    provenance: 'The principles underlying radio communication (National Bureau of Standards, 1922), leaf 514',
  },
];
---

{/* `lg:px-6` rather than the usual `lg:px-8`: the measured band box is 384 CSS px per plate inside 24px side
    padding at 1240, and a different padding would make this markup a different page from the one the round
    measured. `data-slot="PS-5"` is a probe handle — check:space ranks slot boxes by it. */}
{/* `py-12`, not `py-16`: the band's own air is part of what round 15 measured - its 128px of `py-16` was one
    of the two figures A3 was opened with (the other was a 283px hole inside the reasons section, and both are
    superseded by this ruling - the band now brings 96px and the reasons section's inside emptiness is 186px,
    measured 2026-11-05 by `npm run check:space`, D220). Re-measured 2026-11-06 with two event rows on the page:
    reasons is still **186px**, and the largest run inside a surface on this page is the **join section's 274px** - a
    band moving cannot reach either of those, because both are inside a surface rather than between sections
    (D223). R6 took every landing-page band to a single 48px step (D214). The plates keep their box; only the air
    around the shelf moves. */}
<section class="bg-paper py-12" aria-label="Plates from public-domain mathematics books">
  {/* `flex` on the wrapper is not styling: check:space records a `data-slot` box only for a child of a grid or
      flex container, so a PS box inside a plain block is invisible to the survey and to every design round that
      reads it. Measured 2026-11-03: PS-5 was absent from the slot list until its parent became a flex container. */}
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-6 flex">
    <div class="horizon" data-slot="PS-5">
      {plates.map((p) => (
        // A plate with a source is a figure (D312, 2026-11-14): the description is the `alt`, the source is the
        // caption. D170's rule is that alt text is quoted from the picture page, never inferred; putting the book,
        // year and leaf in the caption lets the alt say what a visitor sees instead of where the file came from.
        <figure class="horizon__plate">
          <Image src={p.src} alt={p.alt} class="horizon__img" loading="lazy" decoding="async" />
          <figcaption class="mt-2 text-micro leading-prose text-ink-3 font-body">{p.provenance}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* A shelf, not a grid: the plates share a baseline and keep their own heights, because each box is a whole
     leaf at its own aspect (2.87 / 1.99 / 2.14) and cropping them to one cell aspect is how a diagram loses
     its labels. gap 1rem = the 16px the round measured. */
  .horizon {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }
  /* The plate widths are written HERE rather than as utilities on the element, and they have to be: Astro
     compiles a component <style> selector to `.horizon__plate[data-astro-cid-…]`, specificity (0,2,0), which
     beats every Tailwind utility (0,1,0) - so a `w-1/2` on the figure would lose to the `width: 100%` below
     it and quietly do nothing (measured 2026-11-15: the round-3 read asked for 3-up / 2-up / 1-up and the
     utilities changed nothing). The three rungs are the read's §10: three plates across from 900, two from
     640, one per line below, with the gaps subtracted so a line never wraps for want of 16px. */
  .horizon__plate {
    display: block;
    width: 100%;
  }
  @media (min-width: 640px) {
    .horizon__plate { width: calc((100% - 1rem) / 2); }
  }
  @media (min-width: 900px) {
    .horizon__plate { width: calc((100% - 2rem) / 3); }
  }
  .horizon__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
