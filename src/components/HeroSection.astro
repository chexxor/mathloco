---
import { MARK } from '../lib/brand-mark.mjs';
import PhotoSlot from './PhotoSlot.astro';
import config from '../config.json';
import { content, heroLabel, value } from '../lib/content.ts';

// This column used to hold a stock crowd photograph (`src/assets/math-group-image.jpg`, 6000x4000,
// 1,756,478 B) with an invented alt text — "Math Study Group Session" — which asserted a session this
// club held, with people in it who have never attended. Two ratified rulings already forbade it:
// D86 (stock crowd photography is out, because it shows people who have never attended) and D94 (no
// club photograph exists, so the site is **photo-free by construction** — no surface may *require* a
// picture). Deleting the file is applying a ruling that already existed; this column is what the
// ratified answer for it looks like (D120).
//
// The mark is DRAWN, not imported: no bytes, no srcset ladder, no rights question, and it paints
// through `@theme`, so a stroke here is a colour ROLE that `npm run check:classes` can resolve and
// `npm run check:render` measures on painted bytes against the 3.0 graphic bar (D101/D116). Geometry
// comes from `src/lib/brand-mark.mjs` — the same table the share card composer and both pixel gates
// read, so the two renderings of the club's mark cannot drift.
//
// role -> class, and the class names are LITERAL strings here because that is what makes them exist:
// Tailwind's scanner reads raw source text, so a computed name (`stroke-${token}`) generates nothing,
// and `scripts/check-classes.ts` / `design/gen-token-map.mjs` scan `.astro`/`.svelte`/`.html` but not
// `.mjs`, so a class written in the geometry module would be invisible to all three. The keys are
// MARK's roles, and the coupling between these literals and `MARK_COLOURS.paper` is asserted in
// `design/ratify-check.mjs`, which imports the module and greps this file. Getting it wrong is
// measured rather than trusted: an unmapped role paints no stroke, and `check:render`'s `marks` probe
// fails the run instead of shipping a mark with a hole in it.
// Type-annotated rather than JSDoc-typed: `astro check` treats frontmatter as TypeScript, and a JSDoc
// `@type` there is reported as a hint and then ignored, so the map would have to be keyed by a literal
// role union instead of by role name — which is the drift this comment is about, and the throw below is
// what actually catches it at build time.
const STROKE_CLASS: Record<string, string> = { sphere: 'stroke-rule', route: 'stroke-ink', accent: 'stroke-gold' };
const FILL_CLASS: Record<string, string> = { accent: 'fill-gold' };
// A role with no class paints no stroke, and an invisible shape inside a healthy-looking box is the one
// failure mode a screenshot review misses. check:render catches it with numbers; the build catching it
// first is cheaper, so this throws rather than shipping the hole.
for (const s of MARK.shapes) {
  if (!STROKE_CLASS[s.role]) throw new Error(`brand-mark role "${s.role}" has no stroke class in HeroSection.astro — add it to STROKE_CLASS`);
}
if (!FILL_CLASS[MARK.dot.role]) throw new Error(`brand-mark dot role "${MARK.dot.role}" has no fill class in HeroSection.astro — add it to FILL_CLASS`);

// The label lane is data, not prose. D92: the site publishes series names and real dates, and a frequency
// word is only allowed with a named source (the one it has is recorded beside the word in
// src/content.json). Three states, one lane: a real date when the calendar has one; "Nothing scheduled"
// when a configured calendar holds nothing (round 7's ruling — the label changes rather than disappearing,
// so a visitor can tell an empty calendar from a broken page); and the ruled cadence while no calendar
// source is wired up at all (D132).
const label = heroLabel();
// The hero used to end with "Current Focus: Number Theory and Abstract Algebra". The slot behind it had no
// source, `check:content` had it listed as an unsourced claim, and on 2026-11-03 the operator ruled it false:
// "We no longer have that focus. We have no current focus at all right now." So `focus` here is whatever a
// sourced slot says, and an empty slot renders no line — the section below (What we take up) is what carries
// a subject on the page now, undated by design (src/content.json `threads._rule`).
const focus = value(content.focus);
---

{/* The hero's own air is **64px top and bottom at every width**, which is a ruling rather than a tidy
    number (D214, R6; the pair's measurement is D220). It used to be a responsive ramp - 48/32 base, 48/48
    from `sm`, 128/96 from `md` - and round 15 priced the flat version against the page as it shipped:
    `edges` (hero 128/96 -> 64/64, every band's `py-16` -> 48) bought **-224px of page and -224px of empty
    run at 1440/1240/1024, -64px at 640, -48px at 390/320**; with `rows` (the schedule and reasons edits in
    `Schedule.astro` / `WhyJoinUs.astro`) the page landed **320px shorter and 289px less empty at
    1440/1240, 176px and 114px at 320** @measured 2026-11-05 by `npm run check:rhythm`, whose table
    (`design/rhythm/report.json`) holds both the before row and the after row. One step at every width
    rather than three is deliberate: the option the operator chose was one number, and the phone pays the
    same trim - which is why the phone column is in that table (D161: a desktop-only delta has hidden a
    mobile cost here before), and why 320/390 *gained* air at this edge (48/32 -> 64/64) and still got
    shorter overall. With these margins in place `check:rhythm` re-prices `edges` at 0px/0px at all six
    widths: the row stays in the sweep as a drift guard, and it starts buying pixels again if this edge
    re-inflates. */}
<main
  class='mx-auto max-w-screen-xl px-4 mt-16 mb-16 sm:px-6'
>
  <div class='lg:grid lg:grid-cols-12 lg:gap-8'>
    <div class='mb-12 md:max-w-2xl md:mx-auto lg:col-span-8'>
      <div class='text-label uppercase tracking-wide mb-4'>
        <span class="text-ink-3">{label.text}</span>
      </div>

      <h1
        class='mt-1 text-display-1 tracking-tight font-extrabold text-ink sm:text-display-2'
      >
        Minneapolis Math<!-- -->&nbsp;<br class='hidden md:inline' /><span
          class='text-ink'>Book Club</span>
      </h1>

      <p
        class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
      >
        We meet around a table in a coffee shop or a brewery in the Twin Cities and work through
        something together - a paper, a proof, a proof assistant, a puzzle with a strange answer.
        Dates go up on Meetup; most of the arguing happens in the chat between meetings.
      </p>

      <p
        class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
      >
        There is no syllabus, no reading list to keep up with, and no current focus. What the club is
        pulling on is decided in its own chat, and some of the threads open there are further down
        this page. Bring a question; you don't need a field.
      </p>

      {focus && (
        <p
          class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
        >
          {focus}
        </p>
      )}

      <div>
        <div class='mt-6 sm:mt-8 sm:flex sm:justify-center lg:justify-start'>
          <div>
            <a
              href={`${config.URLs.meetupGroup}/join`}
              target="_blank"
              rel="noopener noreferrer"
              data-control="primary"
              class='w-full flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition'
              >Join Our Group</a
            >
          </div>
          {/* The secondary used to be `target=_blank` at Meetup's own events page, which made the site's own
              schedule page a dead end one click away from a third-party page. `/schedule` is an emitted route
              now (`dist/client/schedule/index.html`), so the label stays honest and `check:content`'s dead-path
              rule can see the target; Meetup stays one step further on, where the sign-up actually is.
              No `target`: an internal navigation that a visitor can go back from. */}
          <div class='mt-3 sm:mt-0 sm:ml-3'>
            <a
              href="/schedule"
              data-control="secondary"
              class='w-full flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition'
            >
              View Schedule
            </a>
          </div>
        </div>
      </div>
    </div>
    <div
      data-slot="PS-1"
      class='mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0 lg:col-span-4 lg:flex lg:flex-col lg:justify-center'
    >
      <!-- PS-1, the hero media column. `check:space` measures it at **376x574** at 1240, and it held only the
           mark (376x235), so 339px of a column the page already pays for painted nothing. Round 13 measured
           seven ways to fill it and the operator ruled **option C** (2026-11-03): the column stacks — plate above,
           mark below, which is one property, `flex-col` — and the plate takes what the mark does not need:
           **307 = 574 − 235 (mark) − 32 (`mb-8`)**. So the column is exactly full and the desktop page is **+
           0px** at 1240. The plate is `src/assets/photos/hero.png` — Byrne 1847 Euclid IV.15, 56% of the leaf,
           built by `npm run plates` from the same crop `npm run round13` measured (sha1 `308193c78a` both).
           What the composition buys, measured: the mark keeps its full column width (376x235), so its thinnest
           stroke lands at **2.04px** against the 1px floor (D119) instead of 1.02px, and the plate is a plate
           rather than a postage stamp. What it costs, measured: the page's chroma >= 0.08 share goes **0.014% ->
           0.297%** (one coloured slot is D149-2b's ruling, and record 0023 priced the loud alternative at
           +2.63%), and below 1024 the hero is not a grid, so the plate adds its own height to the scroll:
           page **5859 -> 6245 (+386px)** at 390, where the plate renders 358x292 and the mark 358x224.
           @measured 2026-11-03 by check:space / check:render (round 13: design/grill/round13/report.json) -->
      <PhotoSlot
        slot="hero"
        ratio="376 / 307"
        alt="Detail of a coloured engraving after John Byrne's 1847 Euclid: a circle with an equilateral hexagon inscribed in it and the diameters drawn through its centre (Book IV, proposition XV)"
        caption="a real meeting: the table, the books, the room (376x307 crop)"
        class="mb-8"
      />
      <!-- No frame, no fill, no keyline around the mark. The `rounded-card overflow-hidden` wrapper here
           was a photograph's frame; around a drawn mark it is a rectangle pretending to be content —
           the same defect that deleted the island's skeleton in apply 4c. The mark is part of the page
           (DESIGN.md "Elevation": hairline means on the page, shadow means above it), so it takes
           neither. -->
      <!-- viewBox units, so `sw` below is in the viewBox's own units; the render gate reports what they
           become in device px, because a 0.9-unit stroke is 1.3px on a 347px box and a sub-pixel
           stroke has no measurable colour identity (D119's lesson, applied to line art). -->
      <svg
        data-mark='hero'
        viewBox={`0 0 ${MARK.vbW} ${MARK.vbH}`}
        class='w-full h-auto block'
        role='img'
        aria-label="Two parallel lines leaving a sphere's equator and crossing at its pole"
      >
        {MARK.shapes.map((s) => (s.tag === 'circle'
          ? <circle cx={s.cx} cy={s.cy} r={s.r} stroke-width={s.sw} stroke-dasharray={s.dash} class={`fill-none ${STROKE_CLASS[s.role]}`} />
          : <path d={s.d} stroke-width={s.sw} stroke-dasharray={s.dash} class={`fill-none ${STROKE_CLASS[s.role]}`} />))}
        <circle cx={MARK.dot.cx} cy={MARK.dot.cy} r={MARK.dot.r} class={`stroke-none ${FILL_CLASS[MARK.dot.role]}`} />
      </svg>
    </div>
  </div>
</main>
