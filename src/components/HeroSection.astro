---
import { Image } from 'astro:assets';
// Imported, not referenced by URL string: `src={'/math-group-image.jpg'}` gave astro:assets nothing
// it could process, so the 6000x4000 / 1,756,478-byte original went to the browser for a ~400 px
// slot. A local import is what turns on the pipeline (resize + AVIF + srcset).
import heroImage from '../assets/math-group-image.jpg';
import config from '../config.json';
---

<main
  class='mx-auto max-w-screen-xl px-4 mb-8 mt-12 sm:mt-12 sm:mb-12 sm:px-6 md:mt-32 md:mb-24'
>
  <div class='lg:grid lg:grid-cols-12 lg:gap-8'>
    <div class='mb-12 md:max-w-2xl md:mx-auto lg:col-span-8'>
      <div class='text-label uppercase tracking-wide mb-4'>
        <span class="text-ink-3">Monthly Meetups</span>
      </div>

      <h1
        class='mt-1 text-display-1 tracking-tight font-extrabold text-ink sm:text-display-2'
      >
        Minneapolis Math<!-- -->&nbsp;<br class='hidden md:inline' /><span
          class='text-ink'>Book Club</span>
      </h1>

      <p
        class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
      >
        Join our passionate community of math enthusiasts as we explore fascinating mathematical texts,
        discuss complex concepts, and share our love for mathematical literature.
      </p>

      <p
        class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
      >
        Whether you're a student, professional, or hobbyist, our monthly book club meetings offer a supportive
        environment to explore mathematical texts and engage in thoughtful discussions.
      </p>

      <p
        class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'
      >
        Current Focus: Number Theory and Abstract Algebra
      </p>

      <div>
        <div class='mt-6 sm:mt-8 sm:flex sm:justify-center lg:justify-start'>
          <div>
            <a
              href={`${config.URLs.meetupGroup}/join`}
              target="_blank"
              rel="noopener noreferrer"
              class='w-full flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition'
              >Join Our Group</a
            >
          </div>
          <div class='mt-3 sm:mt-0 sm:ml-3'>
            <a
              href={`${config.URLs.meetupGroup}/events`}
              target="_blank"
              rel="noopener noreferrer"
              class='w-full flex items-center justify-center px-8 py-3 text-label font-semibold rounded-control text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition'
            >
              View Schedule
            </a>
          </div>
        </div>
      </div>
    </div>
    <div
      class='mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0 lg:col-span-4 lg:flex lg:items-center'
    >
      <div class='rounded-card overflow-hidden'>
        <Image
          src={heroImage}
          width={900}
          height={600}
          sizes="(min-width: 1024px) 33vw, 100vw"
          alt={'Math Study Group Session'}
          format={'avif'}
          loading={'eager'}
          class='w-full h-auto'
        />
      </div>
    </div>
  </div>
</main>
