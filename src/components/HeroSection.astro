---
import { LOGO, LOGO_COLOURS, LOGO_SLOTS } from '../lib/logo.mjs';
import PhotoSlot from './PhotoSlot.astro';
import config from '../config.json';
import { content, value, answers, upcoming, formatDate, timeSpan, copiedOn } from '../lib/content.ts';
import { todayIn, snapshot } from '../lib/events.mjs';
import { scheduleWindow } from '../lib/event-window.mjs';
// The rhythm is generated from the rows this build publishes, by the same module the schedule surfaces use,
// so there is no hand-written cadence sentence to go stale (D383).
import { rhythmSentence } from '../lib/rhythm.mjs';
// The primary control's destination is the resolver's answer for the date the hero prints, so the hero cannot
// point at a page the row under it disagrees with (D384). One call to the same `signUpPaths()` the rows use.
// MS42 (S092, D471): the per-date page lists come from `EVENT_PAGES` in the resolver, and it is empty until the
// handoff carries a per-platform link set — so today this control falls back to the group's join page, and the
// label below says what it is.
import { EVENT_PAGES, signUpPaths, splitPaths } from '../lib/rsvp.mjs';
import { newTabQualifier } from '../lib/links.mjs';

// This column used to hold a stock crowd photograph (`src/assets/math-group-image.jpg`, 6000x4000,
// 1,756,478 B) with an invented alt text — "Math Study Group Session" — which asserted a session this
// club held, with people in it who have never attended. Two ratified rulings already forbade it:
// D86 (stock crowd photography is out, because it shows people who have never attended) and D94 (no
// club photograph exists, so the site is **photo-free by construction** — no surface may *require* a
// picture). Deleting the file is applying a ruling that already existed; this column is what the
// ratified answer for it looks like (D120).
//
// The logo is DRAWN, not imported: no bytes, no srcset ladder, no rights question, and it paints
// through `@theme`, so a stroke here is a colour ROLE that `npm run check:classes` can resolve and
// `npm run check:render` measures on painted bytes against the 3.0 graphic bar (D101/D116). Geometry
// comes from `src/lib/logo.mjs` — the same table the share card composer and both pixel gates
// read, so the two renderings of the club's logo cannot drift.
//
// slot -> class, and the class names are LITERAL strings here because that is what makes them exist:
// Tailwind's scanner reads raw source text, so a computed name (`stroke-${token}`) generates nothing,
// and `scripts/check-classes.ts` / `design/gen-token-map.mjs` scan `.astro`/`.svelte`/`.html` but not
// `.mjs`, so a class written in the geometry module would be invisible to all three. The keys are
// LOGO's SLOTS since the seventh ruling (D483): Byrne's colour *is* a line's name, so a colour has to
// address one drawn shape, and both meridians — one role, `route` — now take two different colours.
// The coupling between these literals and `LOGO_COLOURS.paper` is asserted twice: here, at build time,
// by recomputing each class from the table, and in `design/ratify-check.mjs`, which greps this file for
// each literal. Getting it wrong is measured rather than trusted: an unmapped slot paints no stroke, and
// `check:render`'s `logos` probe fails the run instead of shipping a logo with a hole in it.
// Type-annotated rather than JSDoc-typed: `astro check` treats frontmatter as TypeScript, and a JSDoc
// `@type` there is reported as a hint and then ignored, so the map would have to be keyed by a literal
// role union instead of by slot name — which is the drift this comment is about, and the throw below is
// what actually catches it at build time.
const STROKE_CLASS: Record<string, string> = {
  ring: 'stroke-ink', rear: 'stroke-ink', front: 'stroke-ink',
  left: 'stroke-accent', right: 'stroke-path-calendar',
  angleL: 'stroke-accent-strong', angleR: 'stroke-accent-strong',
};
const FILL_CLASS: Record<string, string> = { dot: 'fill-path-mobilizon' };
// A slot with no class paints no stroke, and an invisible shape inside a healthy-looking box is the one
// failure mode a screenshot review misses. check:render catches it with numbers; the build catching it
// first is cheaper, so this throws rather than shipping the hole. The second half of each check is the
// ratification itself: the class written here must be the class `LOGO_COLOURS.paper` names for that slot,
// so a hero that paints a plausible-but-unchosen colouring is a build failure, not a design review find.
for (const s of LOGO.shapes) {
  if (!LOGO_SLOTS.includes(s.slot)) throw new Error(`logo slot "${s.slot}" is not in LOGO_SLOTS (src/lib/logo.mjs) — the slot table and the shape table have diverged`);
  if (!STROKE_CLASS[s.slot]) throw new Error(`logo slot "${s.slot}" has no stroke class in HeroSection.astro — add it to STROKE_CLASS`);
  const want = `stroke-${LOGO_COLOURS.paper[s.slot]}`;
  if (STROKE_CLASS[s.slot] !== want) throw new Error(`HeroSection.astro paints slot "${s.slot}" with ${STROKE_CLASS[s.slot]} but the ratified colour table (LOGO_COLOURS.paper) names ${want} — the hero drifted from the operator's row (D483)`);
}
{
  const want = `fill-${LOGO_COLOURS.paper[LOGO.dot.slot]}`;
  if (FILL_CLASS[LOGO.dot.slot] !== want) throw new Error(`HeroSection.astro paints the meeting point with ${FILL_CLASS[LOGO.dot.slot] ?? '(nothing)'} but LOGO_COLOURS.paper names ${want}`);
  for (const slot of Object.keys(STROKE_CLASS))
    if (!LOGO_SLOTS.includes(slot)) throw new Error(`HeroSection.astro carries a stroke class for "${slot}", which is no longer a logo slot — a stale class writes a Tailwind utility for a shape that no longer exists`);
}

// The label lane used to open the hero with the club's next date — "Next: Saturday, Nov 7 · 12:00 pm" — which
// put a *date* in the one place on the site whose job is to say what the group is (operator, 2026-11-07: the hero
// "should introduce the group as a whole, not the next meeting"; and the same date appears 300px further down the
// page on the compact schedule card, where it sits beside the leaf that draws it and the dated line that says when
// it was copied). The lane is now a locator about the club, and it cannot go stale, because nothing in it is a
// date. What the lane used to do in its other two states — "Nothing scheduled" instead of nothing at all, so an
// empty calendar is distinguishable from a broken page (DESIGN.md, States) — moved to the surface that actually
// shows a calendar: the compact band's empty state carries the status word, the title, the body and the dated
// line, in the notice grammar `check:render` holds. `heroLabel()` is deleted with this lane (D239).
// The lane said "A book, a room, and whoever shows up" until 2026-11-07, when the operator rebranded the club as
// **Matheapolis** ("I want the focus on the people and the ideas more than the book. the book is more an
// inspiration"). With the name now a single coined word, the lane's job changed: it carries the **descriptor**,
// which is what tells a stranger what "Matheapolis" is a club of. The operator picked "A Twin Cities math club";
// the longer wording they offered ("A math club for the Twin Cities") was measured in the same slot and costs the
// same: 180px vs 242px of ink in a 288px lane at 320, one line box at every width
// @measured 2026-11-07 by `npm run round16` (design/grill/round16/report.json), so the choice is voice, not layout.
// It still contains no date, so the staleness rule that killed the "Next: …" label still holds.
//
// It names **Minneapolis alone** from 2026-11-08 (operator, same day as the ruling below: "Remove St. Paul from the
// subtitle of the club name. Minneapolis being named is sufficient for the subtitle and SEO"). The pair form
// (`Minneapolis–St. Paul math club`) shipped for a few hours and is repriced as the `locator-metro` reversal in
// `design/grill/copy-options.mjs`, so the trade is a number rather than a memory. What the pair bought and what it
// cost, both measured: it is the only form that names both venues the page sources (src/content.json `venues`), and
// it is 35px wider in the lane @measured 2026-11-08 by `npm run round16`.
// The lane said "A Twin Cities math club" until 2026-11-08, when the operator ruled that the descriptor should name
// the city the wordmark puns on: "we should say 'Minneapolis-St. Paul Math Club' instead of 'Twin Cities Math Club'
// to make it clear the name of the club is a play on words with the name of the city" (D243). The pun is `Math`
// inside `Minneapolis`, and a descriptor that says "Twin Cities" never prints the city the wordmark puns on — the
// first half of that ruling stands; the second city is what the same-day correction removed.
// Still a locator, not the wordmark, and still no date. The article is dropped here because the lane is a label, not
// a sentence, and the lane's `uppercase` transform is what the width is spent on: measure before editing, and note
// that the en dash went with the second half it was joining (DESIGN.md type: an en dash pairs place names, and
// `Minneapolis math club` is not a pair). `scripts/check-copy.mjs` asserts this string and `seo.title` still carry
// each other, because the three slots holding the descriptor are separate files and a copy edit that reaches two of
// three is this repo's own documented defect class.
const locator = 'Minneapolis math club';
// The hero used to end with "Current Focus: Number Theory and Abstract Algebra". The slot behind it had no
// source, `check:content` had it listed as an unsourced claim, and on 2026-11-03 the operator ruled it false:
// "We no longer have that focus. We have no current focus at all right now." So `focus` here is whatever a
// sourced slot says, and an empty slot renders no line — the section below (What we take up) is what carries
// a subject on the page now, undated by design (src/content.json `threads._rule`).
const focus = value(content.focus);
// The site's refusals (q05 cost, D376; q10 membership, D377) come out of `refusals()` in src/lib/content.ts
// rather than from strings here, because they are claims with sources - the source is the ruling that decided
// the gap stays open - and because `/join` paints the same two sentences out of the same call, so the pair
// cannot be edited apart on one surface and left stale on the other (D247's defect class, inverted).
const answerLines = answers();
// The club's cadence, in one sentence, derived from the calendar file's own rows (D383). No cadence word:
// `src/lib/cadence.mjs` is the list `check:content` fails a page on when a source does not name the word, and
// this sentence names days and hours instead of a frequency.
const rhythm = rhythmSentence(snapshot.events);
// 2026-11-15 (round-4 design brief §5, ruling D340): **the home page states the next meeting**, and the
// statement lives here rather than in the schedule band below the horizon, because the brief's acceptance test is
// a stranger on a phone asking "when is the next meeting?" and the answer must be visible without scrolling past
// the hero (D-A; it reverses the blanket half of D306 — one *computed* date on the homepage, not a band that
// duplicated `/schedule`). The three rules that make it one fact and not a second calendar:
//   - It is computed from **the same `scheduleWindow(upcoming(), todayIn())` call the nav chip makes** (`src/
//     components/Navigation.astro`), so there is no third place a date can come from. If the two ever disagree,
//     `check:dated-surfaces` fails the build — D311's rule, extended to this surface, and the reason the handle
//     here is `data-date` rather than prose alone.
//   - `Central` appears **once per page** (D327's rule, read §5.1): this is the only other surface on the home
//     page that says it, and the same gate counts it.
//   - The `<time>` element wraps the **whole date phrase**, so an assistive tech hears a sentence rather than a
//     bare number, and the machine-readable value is the same ISO date the `data-date` handle carries (D173,
//     D327 — the same shape `EventRow.astro` writes).
// The sentence this replaces — "The next date, where the club meets, and where to sign up for it are all on the
// schedule." — is deleted in `Schedule.astro`, not reworded: a page that says where the answer is, instead of
// what the answer is, has not answered.
const nextMeeting = scheduleWindow(upcoming(), todayIn()).shown[0] ?? null;
// MS38 (2026-11-19, D447): the hero's date carries the SAME freshness the page of record carries, so a visitor
// reads it as data the club re-reads rather than as a sentence this page typed. `copiedOn()` is D232's rule --
// the stamp is the feed's own `source.fetchedAt`, the value every published `DTSTAMP` in `/events.ics` derives
// from -- so the day printed under the hero date and the day a subscriber's calendar client holds cannot
// disagree. It is the one freshness this page can ground: nothing here fetches, so the only honest claim is
// which read the date came from and when that read happened (D73's topology).
const copied = copiedOn();
// Round-6 review (2026-11-16), Home/Revise + "what to do this week" item 3: the primary control sends a
// visitor who has already decided two clicks from the sign-up. The destination is the one `signUpPaths()`
// returns for the date the hero prints — the same call every row under it makes — so the hero's button and
// the row for that date can never name different pages (D384). When the calendar holds no date, or no
// sign-up page exists for it, the control falls back to `/join`, the club's own route, and the label says
// what it is: a way in, not a sign-up for a date that does not exist.
const signUpFor = nextMeeting
  ? splitPaths(signUpPaths(nextMeeting, EVENT_PAGES.meetup, config.URLs, EVENT_PAGES.discord), config.URLs).row[0] ?? null
  : null;
// The hero's own words for the destination the resolver chose. The accessible-name suffix is derived from THESE
// words rather than copied off the row: `newTabQualifier` adds the platform only when the label does not already
// name it (**S041**), and the hero's label names the date, not the platform - so a suffix computed from the row's
// label ("Sign up on Meetup") would tell a screen reader nothing, which is the D273 defect in a new place. The
// href still comes from the resolver, so D384's coupling between this button and the row for that date is intact.
// The label has to name the destination the resolver actually has. A page for this date is a sign-up *for that
// date*, so the label names the date (round-6 item 3: one click to conversion, D384). A standing club-wide link
// is a different ask — it enrols the visitor in a group — so the label is the resolver's own words for it, and
// `perDate` is what tells the two apart: the same boolean `ctaIdFor()` names the destination with, carried on the
// object so no surface can label a group join as a date's sign-up. `scripts/check-cta-context.mjs` (S090, D467)
// is the gate that fails the build when that happens. Since MS42 the standing branch is the branch every printed
// date takes, until the handoff carries a per-platform link set (docs/spec/event-data-handoff.md).
const heroLabel = signUpFor
  ? (signUpFor.perDate ? `Sign up for ${formatDate(nextMeeting.date, 'short')}` : signUpFor.label)
  : 'Join the club';
---

{/* The hero's own air is **64px top and bottom at every width**, which is a ruling rather than a tidy
    number (D214, R6; the pair's measurement is D220). It used to be a responsive ramp - 48/32 base, 48/48
    from `sm`, 128/96 from `md` - and round 15 priced the flat version against the page as it shipped:
    `edges` (hero 128/96 -> 64/64, every band's `py-16` -> 48) bought **-224px of page and -224px of empty
    run at 1440/1240/1024, -64px at 640, -48px at 390/320**; with `rows` (the schedule and reasons edits in
    `Schedule.astro` / `WhyJoinUs.astro`) the page landed **320px shorter and 289px less empty at
    1440/1240, 176px and 114px at 320** @measured 2026-11-05 by `npm run check:rhythm`, whose table
    (`design/rhythm/report.json`) holds both the before row and the after row. One step at every width
    rather than three is deliberate: the option the operator chose was one number, and the phone pays the
    same trim - which is why the phone column is in that table (D161: a desktop-only delta has hidden a
    mobile cost here before), and why 320/390 *gained* air at this edge (48/32 -> 64/64) and still got
    shorter overall. With these margins in place `check:rhythm` re-prices `edges` at 0px/0px at all six
    widths: the row stays in the sweep as a drift guard, and it starts buying pixels again if this edge
    re-inflates. */}
<main
  id="main"
  class='mx-auto max-w-screen-xl px-4 mt-16 mb-16 sm:px-6'
>
  <div class='lg:grid lg:grid-cols-12 lg:gap-8'>
    <div class='mb-12 md:max-w-2xl md:mx-auto lg:col-span-8'>
      {/* 2026-11-14 (S040, second design read §1): nothing sits ABOVE a page's h1 any more. The descriptor used
          to sit here as an eyebrow; the words are the same ones D243 settled, and `check:copy` still asserts this
          string against `seo.title`, so only the position moved - the name first, then what it is, the way a
          book page sets a subtitle. The invariants the old comment carried stay in force: this line is not a
          date (D239) and not a cadence word (D92 - a frequency word needs its source in the same breath, and a
          subtitle is too short a breath for one). `mt-1` goes with it: the h1 is now the first thing in the
          column, so there is nothing for it to be 4px away from. */}

      {/* One word, one line, at every width this site is probed at (1240 / 640 / 390 / 320): the name is 251px of
          ink at display-2 with 672px available at 1240, and 209px in 288px at 320 @measured 2026-11-07 by
          `npm run round16`. The shipped h1 needed a `&nbsp;` tie and a `hidden md:inline` <br> to break "Minneapolis
          Math Book Club" into two lines that did not orphan a word; none of that machinery survives the rename,
          and the phone gets its fold back (-56px of page at 320, -7px at 390). The `text-ink` span on the second
          half went with the second half.

          One display step bigger from `sm` (approved 2026-11-08). The rename created this choice: one 11-letter
          word had 421px of unused line at 1240 at display-2, and the old three-word name never had that air to
          spend. The step is priced, not asserted - the name goes from 250.5px to 300.4px of ink in a 672px column at
          1240, the identity column keeps its 10 line boxes there, and the page costs **+0 at 1240, +8 at 640, +0 at
          390, +0 at 320** @measured 2026-11-08 by `npm run round16`: the reversal option (`size-2`) measures
          3140/4550/4713/5223 against the shipped 3140/4558/4713/5223. The `sm:` bound is why three of those four
          are zero - at 390 and 320 the h1 is display-1 either way, and `DESIGN.md`'s fit table is why that matters
          (display-3's 309.3px longest-word fit needs ~310px of box; the boxes are 276 at 320, 346 at 390).

          The ladder stops here for a reason found the hard way. Pricing `sm:text-display-4` measured **-16px at
          640** with the name at 208.7px of ink - what display-1 paints - because no source file uses that class, so
          Tailwind emits no rule for it and the mutation removed a step instead of adding one. `design/round16.mjs`
          now throws on any class an option adds that the built CSS does not emit; the ceiling that stays typed is
          `DESIGN.md`'s own ban on `text-display-4` below a 375 viewport without a cap. */}
      <h1
        class='text-display-1 tracking-tight font-extrabold text-ink sm:text-display-3'
      >
        Matheapolis
      </h1>
      <p class='mt-2 text-label uppercase tracking-wide text-ink-3'>{locator}</p>

      {/* The operator's rulings letter of 2026-11-16 (R9, D357) is what put one sentence HERE, between the
          locator and the meeting block. R9 accepts the answers-first order and names the one part of it it
          would not leave: a first-time visitor now meets an imperative — "Join Our Group" — before any
          sentence says what the group is. Its fix needs no new copy: hoist one existing sentence above the
          meeting block, so the page says what it is before it says come. The letter named the tagline line
          beginning "A book, a room, and whoever shows up"; that line was deleted with `heroLabel()` under
          D239 (and `check:content` still lists it as banned copy), so the letter's own fallback applies and
          what moves is the FIRST SENTENCE OF THE LEDE — and this commit says so, which is what the letter
          asked for in that branch. Order only: the classes below are the lede paragraph's, unchanged, so no
          type, no spacing, no colour and no new way in — D303's single primary control and the `check:space`
          ramp stay as they were measured. Measured, not argued — @measured 2026-11-16 by `node design/fold-answers.mjs --no-build`
          (Linux native, Node 24.22.1): with the hoist in place all 5 answers are above the fold at both phone
          columns — at 390x844 the when-line and the venue line sit at y=439-487 and y=491-547, the controls at
          y=571-619 and y=631-679, on a 4265px page; at 320x844 they sit at y=472-520 and y=524-609, the controls
          at y=633-681 and y=693-741, on a 4741px page. Before the hoist the same probe put them at y=224-272 /
          y=276-332 and y=356-404 / y=416-464 at 390, and y=224-272 / y=276-361 and y=385-433 / y=445-493 at 320,
          on pages 4253px and 4729px — so 0 of 5 past 844 at either column BEFORE the hoist as well, and the letter's
          pre-committed table takes its FIRST row (ship as-is, closed) while its third row — an answer already past
          844 at 320 without the hoist, the escalation — did not fire. What the hoist itself costs is measured the
          same way: the meeting block moves down +215px at 390 and +248px at 320, and the page grows **+12px at
          390 and +12px at 320**, because the sentence left the lede paragraph it came from and the paragraph it
          left is roughly as tall as the paragraph it joined. Nothing here is past the fold at either column, and
          the margin at 320 is 103px — this is the one measurement that would change R9's answer, and the letter
          says the escalation it pre-committed is not to be fixed in this branch. */}
      {/* Round-8 review (2026-11-18), Home/Revise "split the lede at the dash": one 31-word sentence made the
          page open by piling on its own clause. The dash becomes a full stop, so the second half is its own
          sentence and the first half stops before the list. The same round then split what remained, because
          this round's row for the item prices a number rather than a memory: `/`'s longest sentence of its OWN
          prose has to land under 20 words, and "…in the Twin Cities and work through something together" is 21
          of one breath. Splitting at the conjunction is the same edit one clause further down - two words added
          ("We"), nothing moved, nothing re-inflected, and the list sentence below is untouched. */}
      <p class='mt-3 text-lede leading-prose text-ink-2 sm:mt-6 font-body'>
        We meet around a table in a coffee shop or a brewery in the Twin Cities. We work through something together.
        A paper, a proof, a proof assistant, a puzzle with a strange answer.
      </p>

      {/* D340 (round-4 §5, 2026-11-15): the answer to "when is the next meeting?", above the fold, computed —
          and the one thing this block is NOT is a second calendar: `nextMeeting` comes from the same
          `scheduleWindow(upcoming(), todayIn())` call the nav chip makes, the `data-date` handle is what lets
          `check:dated-surfaces` compare the two, and the `<time>` element carries the same ISO value so a screen
          reader hears a sentence rather than "21". `tabular-nums` is the same device the schedule page's dated
          line uses; the two paragraphs are the meeting's own two facts — when, and where. No link here: the
          page's one primary control is below, and a second way in from the hero is the defect D303 names.
          Its position is D350's (round-4 §5, same day): it used to sit after the two lede paragraphs, at y=822
          and y=874 against a 390x844 fold, which is present-but-not-on-the-first-screen; the brief's own sketch
          puts the meeting and its controls at the top of the hero, so the block leads the prose now. */}
      {/* MS41 (S090, D467): the two controls below are the page's asks, and this element declares itself as their
        context: the computed next meeting (which date), the venue, the rhythm, the freshness line, and the two
        sentences answering cost and belonging. That is the block `scripts/check-cta-context.mjs` reads, and its id
        list follows the resolver - `signUpFor.cta` is `src/lib/links.mjs` naming the destination `signUpPaths()`
        chose for this date (a date's own Meetup page, or the standing group when the date has no page), falling
        back to `/join` exactly as the href does. The controls stay hand-written rather than `CallToAction`s:
        `scripts/check-rsvp-page.mjs` compares this button's painted bytes with the resolver's answer (D384), and
        the `w-full` step and the `data-rsvp-date` handle are the hero's own. The idiom is the id and the declared
        block, which the gate reads off the artifact - not the component. */}
      <div data-cta-block={`${signUpFor?.cta ?? 'join-page'} dates-page`}>
      {nextMeeting && (
        <div data-surface="next-meeting" data-date={nextMeeting.date} class="mt-6 sm:mt-8 max-w-measure">
          <p class="tabular-nums"><time datetime={nextMeeting.date}><span class="text-label text-ink-3">Next meeting: {formatDate(nextMeeting.date, 'wide')} · {timeSpan(nextMeeting)} Central</span></time></p>
          {nextMeeting.venue && <p class="mt-1 text-body leading-prose text-ink-2 font-body">{nextMeeting.venue}</p>}
          {/* Round-6 review, Home/Add and "this week" item 2 (D383): the rhythm sits here, beside the date,
              because a rhythm is only useful next to a date a visitor can act on. It is generated from the
              rows the calendar publishes, so it cannot name a cadence the club stopped keeping. The review's
              own wording ("Saturdays at noon, most months") is not used: "most months" is a cadence word in
              `src/lib/cadence.mjs`, and `check:content` fails a page for a cadence word its source does not
              name (D92, D301). */}
          {rhythm && <p class="mt-1 text-body leading-prose text-ink-2 font-body">{rhythm}</p>}
          {/* MS38 (2026-11-19, D447, ruling S073): the freshness register, in the slot DESIGN.md rules it --
              `text-label text-ink-3 tabular-nums`, wording from `provenanceStamp()` via `copiedOn()` -- as the
              LAST line of the block, so the stamp closes the block the way `/dates` closes its list (D232's
              "the stamp under a date is the feed's stamp"). The operator's word was that this date does not read
              as maintained data; what this tree can ground is which read it came from and when that read ran
              (D73: nothing fetches Mobilizon at request time; every route is prerendered). Motion, a pulse and
              a "live" chip are refused for that reason -- D115 ruled the infinite pulse out, `check:reduced-motion`
              (MS35) owns the only two motion tiers, and a live region over static content would announce nothing.
              The sentence is `/dates`'s verbatim: D322 rules one wording for one provenance fact, so the repeat
              across two pages a visitor reads one click apart is signed in `design/copy-duplicates.json` under
              S073 rather than reworded to satisfy a detector (D432's precedent, and the pair already in that file
              for `/dates`'s own two surfaces). `copied` is null only when no source is wired, in which case there
              is no read to name and no line -- the empty state belongs to `/dates`, which owns the calendar. */}
          {copied && <p class="mt-1 text-label text-ink-3 tabular-nums">Copied from the club’s own calendar {copied}</p>}
        </div>
