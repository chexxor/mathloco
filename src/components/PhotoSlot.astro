---
import { Image } from 'astro:assets';
import { content } from '../lib/content.ts';

/**
 * A reserved photograph place, with its size declared rather than discovered.
 *
 * Why this exists (operator ruling, grill round 10, 2026-11-02): the club has no photographs yet, and
 * "no photos" has been used as a reason for empty columns. A slot that is *reserved* — measured geometry,
 * a declared aspect ratio, and a defined state when there is no picture — turns "get photos" into a shot
 * list instead of a mood. What the two reserved places measure now, from `npm run check:space` walking the
 * built page's grid/flex children (`design/grill/round10/report.json` is the older record):
 *
 * - PS-1, the hero media column: the column is **376x574** at 1240 and the mark inside it paints
 *   **376x235**, so 339px of the column paints nothing — a plate there is a reclamation, not a growth.
 *   @measured 2026-11-03 by check:space
 * - PS-3, the join media column: **532x56** at 1240 (one paragraph) inside a grid row that is **326** tall;
 *   **310x85** at 390, **240x113** at 320. It used to be 128px of call-to-action, and round 10 therefore
 *   called a photo here "a growth of ~152px, not a reclamation". The two join actions now stand outside the
 *   tinted card (D149-3c), so the row's height belongs to the copy column beside it and a plate at the
 *   reserved 532x128 fits inside a row the page already pays for at 1240. At 390 it is still a growth
 *   (~107px), because the grid is one column there.
 *   @measured 2026-11-03 by check:space
 *
 * Those numbers are NOT design tokens — they are what the layout already is, so a filled slot cannot
 * quietly change the page's geometry.
 *
 * The aspect ratio is declared in CSS, not left to the file. Tailwind's preflight sets `img { height:
 * auto }`, which makes an HTML `height` attribute inert: the Meetup png in this same column asked for
 * `200x80` and rendered `200x192`, because only its width was ever honoured (`design/records/0013`,
 * `design/records/0014`). Without a declared ratio the document reflows when the image decodes — measured
 * here as `2495px -> 2607px`, a 112px jump.
 *
 * The empty state is the fallback content, chosen per call site, and it is always something a visitor can
 * use. A grey box labelled "photo coming" is a production note wearing a visitor's clothes — hatched
 * placeholders belong in `npm run round10`'s diagrams, where they tell the operator what to shoot, not on
 * the site (DESIGN.md "States: empty, loading, failed").
 */
type Props = {
  /** Which file fills this place: `src/assets/photos/<slot>.<ext>`. First match wins. */
  slot: string;
  /** What the photograph shows, in the club's own words. Required the moment a photo exists (see below). */
  alt?: string;
  /** CSS `aspect-ratio`, e.g. `376 / 250`. Must match the crop in the shot list. */
  ratio: string;
  /** What the shot has to be, in the shot list's words. Only ever drawn in placeholder mode. */
  caption?: string;
  /**
   * Where the picture came from, in a visible line under it (2026-11-14, MS04 read). A plate's provenance -
   * "Slaught & Lennes, 1910, leaf 122" - is a fact about the file, not a description of what a visitor sees,
   * and D170's rule is that alt text quotes the picture page rather than invent a scene. So the description
   * goes in `alt` and the source goes here. `scripts/check-alt.mjs` fails an `alt` that still carries a
   * year-and-publisher or a leaf number with no caption under it.
   */
  provenance?: string;
  class?: string;
};

// Files land here rather than in `public/` so Astro's asset pipeline resizes and formats them: a phone
// camera frame is ~4000x3000 and the slot it fills is 526 CSS px wide.
const PHOTOS = import.meta.glob('../assets/photos/*.{jpg,jpeg,png,avif,webp}', { eager: true });
const found = Object.keys(PHOTOS)
  .filter((k) => k.split('/').pop()!.toLowerCase().startsWith(`${Astro.props.slot.toLowerCase()}.`))
  .sort()[0];
const photo = found ? (PHOTOS[found] as { default?: unknown }).default : undefined;

const { ratio } = Astro.props;
// Placeholder mode (operator, 2026-11-03: "use placeholders for the content you are missing"). It is a
// REVIEW state, not a visitor state: DESIGN.md and this component's own comment say a grey box labelled
// "photo coming" is a production note wearing a visitor's clothes. So it is reachable only from
// src/content.local.json, which is gitignored — and `npm run check:content` fails any build whose HTML
// contains a `data-placeholder` fill, so the state cannot reach the apex even by accident. What it draws
// is the measured box plus what has to be in it, which makes the preview tell the operator what to shoot
// instead of hiding the geometry behind an empty column.
const placeholders = content.photos?.placeholders === true;
// An invented or placeholder alt is the same defect as an invented photograph, and it is the kind that
// ships silently because nothing renders it visually. So the build refuses instead: when a photo lands in
// src/assets/photos/, the call site has to say what it shows.
if (photo && !Astro.props.alt) {
  throw new Error(
    `PhotoSlot "${Astro.props.slot}": ${found} needs an alt describing what the photograph shows — ` +
      `an invented or missing alt asserts something the picture does not support`,
  );
}
---

{
  photo ? (
    /* A plate with a source is a figure. The wrapper costs one line of `--micro` type and nothing else:
       Tailwind's preflight zeroes `figure`'s margin, so the box that `check:space` measures is the image plus
       the caption's own `mt-2`, and `check:space`/`check:render` re-measure it every run.
       (D312.) */
    <figure>
      <Image
        src={photo as never}
        alt={Astro.props.alt!}
        loading="eager"
        decoding="async"
        class={`w-full block object-cover ${Astro.props.class ?? ''}`}
        style={`aspect-ratio: ${ratio};`}
      />
      {Astro.props.provenance && (
        <figcaption class="mt-2 text-micro leading-prose text-ink-3 font-body">{Astro.props.provenance}</figcaption>
      )}
    </figure>
  ) : placeholders ? (
    /* One ground, one edge (D149-3c). This used to be `bg-tint inset-shadow-rule`, and the review build
       measures what that actually paints: a 1px `rule` ring with the tint (224,245,229) on its inside and
       the page's ground on its outside — 2.74 inside / 3.01 outside at PS-1, and 2.74 / 2.88 at PS-3, where
       the join card is `bg-panel`. Two grounds, and both numbers sit at or under the 3.0 graphic bar
       (`--color-rule` is solved for `paper`: 3.01 there, 2.74 on `tint`, 2.88 on `panel` — record 0018).
       `check:render`'s ring rule now fails exactly this, and it is the only gate that ever saw it: this state
       is unreachable in a shipped build (`check:content` fails any HTML containing `data-placeholder`), so no
       browser gate looks at the real dist page. See design/records/0024-* for the review-build recipe.
       The fill is the half that goes: a tint is 1.04-1.10 against its neighbours, so it was never doing the
       separation the ring does. The edge is `inset-shadow-gold` rather than `rule` because a `rule` ring is
       illegal inside a tinted region at ANY placement: inside the join card it reads 2.88 on both sides,
       under the bar. Gold reads 4.82 on paper and 4.61 on panel, and either way the ring has ONE ground on
       both sides. Gold is this system's caution grammar, and that is the honest claim here: the box says
       "this page is missing content", which is a caution about the page rather than a decoration. */
    <div
      data-placeholder={Astro.props.slot}
      class={`inset-shadow-gold rounded-control flex items-end p-3 ${Astro.props.class ?? ''}`}
      style={`aspect-ratio: ${ratio};`}
    >
      <p class="text-micro uppercase tracking-wide text-ink-3">
        {Astro.props.slot} · {ratio.replace(/\s*\/\s*/, ' / ')} · {Astro.props.caption ?? 'a photograph of this club goes here'}
      </p>
    </div>
  ) : (
    <slot />
  )
}
