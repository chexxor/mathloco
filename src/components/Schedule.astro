---
import config from '../config.json';
import PhotoSlot from '../components/PhotoSlot.astro';
import {
  content, upcoming, value, filled, formatDate, formatTime, builtOn, scheduleConfigured,
} from '../lib/content.ts';

/**
 * When we meet — the section that replaced `UpcomingMeetups.astro` and `PastEvents.astro`
 * (operator request, 2026-11-03: use placeholders for the content we are missing).
 *
 * What it replaced, and why the replacement had to be written rather than enabled:
 * `.notes/roadmap-events.md` measured `UpcomingMeetups.astro` as "**entirely invented placeholder
 * content**" — "Saturday, 2:00 PM", "Local Library - Study Room B", "Topic: Introduction to Group
 * Theory", a "Reserve Your Spot" button — and said any schedule work should **replace** it, not turn it
 * on. It was also pre-design CSS (`bg-blue-50`, `text-gray-900`, `shadow-lg`) and it pointed at
 * `/math-study-session.jpg`, a file that is not in `public/`, so switching the flag on would have both
 * published fiction about a real club and failed the build. `PastEvents.astro` was `<h2>Past Events</h2>`
 * and a comment. Both flags were `false` in `src/config.json`, and prod agrees — the curl numbers are in
 * the roadmap note.
 *
 * The three states, all designed (record 0010: missing content is a state, never a blank, never a build
 * failure; DESIGN.md "States"):
 *   - **dates exist** → rows: date lane, series name, status word. D92: the site publishes **series names
 *     and real dates**, never a frequency.
 *   - **a source is configured and holds nothing** → the round-7 empty state the operator chose (option A as
 *     measured then: 305px, status word + title + two-line body + a 48px primary and a 40px secondary — D139
 *     has since retired the 40px step for buttons — + the dated line, "two paths out"), because a guaranteed
 *     condition of an upcoming-only feed is a gap between events.
 *   - **no source configured yet** (today: D132 rules the source is Mobilizon or an ICS feed and the
 *     operator has to provision one) → the same block, with its own status line, and the bracketed
 *     `[venue blurb]` from `src/content.json` **not rendered**: a bracket is a hole in our knowledge, and
 *     DESIGN.md keeps brackets off the page until a source exists. `scripts/check-content.mjs` fails a
 *     build that ships one.
 *
 * Controls, after the D139 ruling (2026-11-03):
 *   - One control: the **48px primary** in the hero's own grammar (`px-8 py-4`, no hard-coded height —
 *     DESIGN.md: "heights are derived, not chosen"), and it declares `data-control="primary"` because the
 *     height rules now match the name the source publishes (D140).
 *   - The **second path is an inline link, not a second button.** It was written while the gate still demanded
 *     a 40px secondary and then forbade one (record 0016); the ruling retired 40px for buttons, so a second
 *     button would now be legal at 48px. It stays a link anyway: DESIGN.md prices an in-sentence path at its
 *     24px line, and a notice-shaped block reads better with one pressable block and one path in prose than
 *     with two buttons of the same size. If a future round wants the button, `data-control="secondary"` is
 *     the name it must carry.
 * Both paths still go somewhere that exists — Meetup and `/chat`. No "Past meetings" button: there is no
 * past-events page, and D117's rule is that a path needs a page (that is what killed `Schedule` and
 * `Members` from the nav).
 */
const items = upcoming().slice(0, 4);

/**
 * PS-4 — the event-card thumb, filled for the one row that has art (operator ruling 10(a), 2026-11-04, D190).
 *
 * Keyed by slug, because the file in `src/assets/photos/` is named after the row (`event-<slug>.png`) and
 * `PhotoSlot` resolves it by filename prefix. The `ratio` is **the art's own** (954x460), not the 323x110 the
 * slot was first defined at: D168 ruled that a plate is not cropped to fit a box, and the club's own event
 * image is a plate — 323x110 would have cut 30% of its height.
 *
 * The `alt` states only what the file's role proves. It does **not** describe the frame: this session's model
 * takes no images, and D170's rule ("alt text and provenance are quoted from the picture page, not inferred")
 * is exactly the rule that forbids writing what nobody read. The organizer's own sentence for the image is
 * asked for in `.notes/NEXT.md`; when it arrives it replaces this string verbatim.
 *
 * A row with no entry renders NO box at all: `PhotoSlot`'s fallback is its own `<slot />`, which is empty
 * here. That is a designed absence, not a hole — DESIGN.md's states rule bars a "photo coming" box, and the
 * hatched stand-in belongs in review rounds (`npm run round10`), not on the page.
 */
const SLOT_ART: Record<string, { ratio: string; alt: string }> = {
  '2026-11-07-club-social': {
    ratio: '954 / 460',
    alt: 'The club\u2019s own event image for this social',
  },
};
const empty = content.schedule?.empty;
const venueLine = value(empty?.venueLine);
// The status word distinguishes "nothing scheduled" from "we have not wired the calendar yet" — the first
// is a fact about the club, the second is a fact about this page, and only the first may be stated as the
// club's. With no source configured the block says what the page knows: dates live on Meetup.
const status = scheduleConfigured() ? (empty?.status ?? 'Nothing scheduled') : 'Dates live on Meetup';
const title = empty?.title ?? 'No date is on the calendar yet.';
const body = empty?.body ?? 'Dates are set in the club\'s Discord and posted on Meetup, where the calendar and the sign-up live.';
---

<section class="bg-paper py-16" aria-labelledby="when-we-meet">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 id="when-we-meet" class="text-heading font-extrabold text-ink">When We Meet</h2>
      <p class="mt-4 text-lede leading-prose text-ink-2 font-body max-w-measure mx-auto">
        These dates are copied from the club's own calendar. The sign-up is on Meetup.
      </p>
    </div>

    <div class="mt-12">
      {items.length ? (
        <ul class="space-y-6" data-art-cap="323">
          {items.map((item) => (
            <li class="inset-shadow-rule rounded-control px-4 py-3 flex flex-col">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="text-label font-medium text-ink tabular-nums">
                  {formatDate(item.date, 'wide')}
                </span>
                {/* A JSX comment, not `//`: inside `{items.map()}` the template body is JSX children, where a
                    `//` line is not a comment at all — it shipped as visible text in every card (2026-11-04).
                    One text node, so the render gate sees one measurement. An unconfirmed hour prints
                    "time not set" rather than a guessed one (D172); a confirmed one prints the span the
                    organizer set, in the club's own zone. */}
                <span class="text-label text-ink-3">
                  {item.time
                    ? `${formatTime(item.time)}${item.endTime ? ` – ${formatTime(item.endTime)}` : ''}`
                    : 'time not set'}
                </span>
                {filled(item.status) && (
                  <span class="text-label font-medium text-ink-2 uppercase tracking-wide">{item.status}</span>
                )}
              </div>
              <h3 class="mt-1 text-lede font-bold text-ink font-body">{item.title}</h3>
              {filled(item.series) && (
                <p class="mt-1 text-body leading-prose text-ink-2 font-body">{item.series}</p>
              )}
              {filled(item.venue) && (
                // The address is a fact the organizer typed, with a source (data/events.json carries the
                // feed it came from), so D92's bracket rule does not apply to it. The organizer's full
                // `LOCATION` string — street, postcode, state, country — is what the feed publishes; the
                // page shows the navigable line.
                <p class="mt-1 text-body leading-prose text-ink-2 font-body">{item.venue}</p>
              )}
              {/* PS-4 (D190): the club's own event art, mirrored into src/assets/photos/ and resolved by
                  filename, so adding art to a row is a file drop rather than an edit.
                  `data-slot="PS-4"` is a probe handle (check:space ranks slot boxes by it), and the row is
                  `flex flex-col` for the same reason: the survey records a data-slot box only for a child of a
                  grid or flex container, so without it PS-4 is invisible to every design round that reads it
                  (measured 2026-11-03 for PS-5, same mechanism).
                  The wrapper renders ONLY for a row with art, so a row without art keeps the geometry it had
                  before this change byte for byte — a designed absence is the absence of a box, not an empty
                  one (DESIGN.md "States"). */}
              {SLOT_ART[item.slug ?? ''] && (
                <div data-slot="PS-4" class="event-slot">
                  <PhotoSlot
                    slot={`event-${item.slug}`}
                    ratio={SLOT_ART[item.slug ?? '']?.ratio ?? '954 / 460'}
                    alt={SLOT_ART[item.slug ?? '']?.alt}
                    class="rounded-control event-art"
                  />
                </div>
              )}
              <p class="mt-2 text-body leading-prose text-ink-2 font-body">
                <a
                  href={config.URLs.meetupGroup}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink underline hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
                >
                  Details and sign-up on Meetup</a
                >.
              </p>
            </li>
          ))}
        </ul>
        // One path out, in prose rather than a second button (the D139 ruling prices an in-sentence path at
        // its 24px line). The link is the feed itself: a person pastes that URL into Google Calendar, Apple
        // Calendar or Outlook and the dates follow the club from then on. Deliberately not a `webcal://`
        // shortcut — an https link either opens a client or downloads a file a client opens, and a scheme
        // that some browsers refuse would be a promise this page cannot keep.
        <p class="mt-6 text-body leading-prose text-ink-2 font-body">
          Want them in your own calendar? <a href="/events.ics" class="text-ink underline hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold">Add the club calendar</a> —
          Google, Apple and Outlook can all follow that link, and it changes when the club changes a date.
        </p>
      ) : (
        // The chosen empty state (round 7, option A) in the shipped notice grammar: status word, `--lede`
        // title, two-line body, a 48px primary, the second path, the dated line. The second path is an inline
        // link rather than a 40px secondary button — see the control note at the top of this file. `min-h-20`
        // is not needed here: this block is prerendered at its full height, so there is no arrival to shift
        // the page.
        <div class="max-w-measure">
          <div role="status" class="inset-shadow-rule rounded-control px-4 py-6">
            <p class="text-label font-medium text-ink-3">{status}</p>
            <h3 class="mt-1 text-lede font-bold text-ink font-body">{title}</h3>
            <p class="mt-2 text-body leading-prose text-ink-2 font-body">{body}</p>
            {venueLine && <p class="mt-2 text-body leading-prose text-ink-2 font-body">{venueLine}</p>}
            <p class="mt-3 text-label text-ink-3 tabular-nums">This page was built {builtOn()}; no calendar source is wired to it yet.</p>
          </div>
          <!-- One boundary (operator ruling, 2026-11-03): the ring is the notice's edge and the only edge in
               it, so the paths out sit BELOW the box rather than inside it. `role="status"` is what makes that
               block measurable — `check:render` then holds it to the notice grammar (no fill, 1px ring at the
               ratified contrast, 48px+) and fails any filled or ringed action that ever moves back inside.
               Before this change the primary button sat inside the ring: one box, two edges. -->
          <div class="mt-4">
            <a
              href={`${config.URLs.meetupGroup}/join`}
              target="_blank"
              rel="noopener noreferrer"
              data-control="primary"
              class="inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
            >
              Join on Meetup
            </a>
          </div>
          <p class="mt-3 text-body leading-prose text-ink-2 font-body">
            Want to ask before you come? <a href="/chat" class="text-ink underline hover:text-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold">Ask in the chat</a> —
            someone from the club reads it.
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* PS-4 is capped at its declared slot width — **323 CSS px**, the card interior round 13 measured — because
     these rows are full-width strips, not cards. Measured on the first build of this change with no cap: the
     954px art rendered **1132x546** at 1240, which is a 1.19x upscale of the file, one image painting 11.28%
     of the page, and **+558px** of document. Capped, the box is 323x156 at 1240 (the art's own 954/460 aspect,
     uncropped per D168) and 326x157 -> 256x123 down the phone widths, every one a downscale.
     The width lives here rather than in a `w-[323px]` class because 323px is a measured slot, not a spacing
     step, and `check:classes` is right to treat a one-off bracket value as a smell. */
  .event-slot {
    margin-top: 0.75rem;
    width: 100%;
    max-width: 323px;
  }
  .event-art {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
