---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { URLs } from '../config.json';
import { PLATFORMS } from '../lib/rsvp.mjs';
import { newTabQualifier } from '../lib/links.mjs';
import { snapshot, todayIn } from '../lib/events.mjs';
import { publishableRows, publishedName } from '../lib/event-groups.mjs';
// The window rules live outside this page so the gate that reads the built bytes (`scripts/check-rsvp-page.mjs`,
// rule 10) can compare them against the same rule rather than a copy of it (D238's lesson, applied to the
// past half by D374).
import { pastWindow, isPast, dateOf, plainDate } from '../lib/event-window.mjs';

/**
 * The page of record for dates that have **finished** (D374, round-5 read Batch D half 2).
 *
 * Why a page at all: q24 ("Can I look for a specific past meetup?") was UNANSWERED on every surface the
 * probe reads, and its one answer was a URL pasted into Meetup. The data already carries the answer —
 * D72 keeps a row that has been retired rather than deleting it, and `/events.ics` publishes it with
 * `STATUS:CANCELLED` and a raised SEQUENCE — so the fact exists and was printed nowhere.
 *
 * Why the URL is `/past` and not an anchor on `/dates`: `/dates` is a **window** (D238's `HORIZON_WEEKS`
 * and `MAX_ROWS`), and its own copy says what it left out. A page of finished dates has the opposite
 * bound — no horizon backwards, only the cap — so it is a different answer to a different question, and
 * `check:dated-surfaces` rules each surface apart from the other rather than letting one page carry both.
 *
 * What it may print, and only that:
 *   - a date **only if it is a row the build already holds** that has finished and was not announced
 *     cancelled (`isPast` in `src/lib/event-window.mjs`) — the grouping runs through `publishableRows`,
 *     the same projection `/dates` and `/events.ics` publish from, so a superseded row (D72/D318 keeps
 *     it in the data) cannot reach a page by taking the past door;
 *   - the ~twelve words naming the club's own Meetup page, **reusing** the group URL the exit band already
 *     paints at the foot of this page (R1/D358's ceiling: an exit the band owns is not painted twice as
 *     an affordance, and the band's URL is the one source).
 *
 * Today the honest state is an empty one: @measured 2026-11-16, `data/events.json` holds 8 rows, two of
 * them dated before today, and both carry `status: CANCELLED` — so `isPast` returns false for all of them
 * and this page lists nothing. That is a designed state (DESIGN.md "States": missing content is a state,
 * never a blank), and the sentence under it is generated from the count rather than written, because a
 * hand-written "the club met twice before" is a claim that expires with the next harvest.
 *
 * Deliberate, and named where a future session will look:
 *   - a past row carries `data-surface="past-row"`, not `data-surface="row"`. `scripts/check-row-geometry.mjs`
 *     and `scripts/check-rsvp-page.mjs` both key their **row** rules on that handle, and those rules are
 *     about a date a visitor can still act on — a leaf, a capped prose zone, and one sign-up primary. A
 *     date that has finished offers no sign-up page, so it is not a row in that contract's sense; rule 10
 *     in `scripts/check-rsvp-page.mjs` owns this handle, and it refuses an open date, a cancelled date and
 *     a date no row carries.
 *   - the page paints no sign-up cluster and no platform marks: rule 9 of that gate would demand an island
 *     per cluster, and a meeting that has happened has nothing to sign up for.
 */
export const prerender = true;

const today = todayIn();
const held = publishableRows(snapshot.events).rows;
const win = pastWindow(held, today);
// Dates the calendar holds that have already finished and were **announced** cancelled — the reason the
// empty state below says what it says, and the reason it is counted rather than remembered (D72 keeps
// these rows so a subscriber can retire them; this page is what refuses to call them meetings).
const closedOff = held.filter((r) => {
  const d = dateOf(r);
  return !!d && d < today && String(r.status ?? '').toUpperCase() === 'CANCELLED';
}).length;
const emptyBody = win.total === 0
  ? (closedOff
      ? 'The dates our own calendar holds that have already passed were announced cancelled.'
      : 'Our calendar holds no date that has finished yet.')
  : null;
const olderText = win.hiddenCap > 0
  ? `This page lists ${win.shown.length} of them, newest first; ${win.hiddenCap} older date(s) are not listed here.`
  : null;
---

{/* Round-6 review (2026-11-16), `/dates`/Remove and the site-wide half of it (D404): the route is unlinked
    from `/dates` until it holds three completed meetings, and it is **noindexed** meanwhile — the letter's own
    words, "Unlink until there are three completed meetings; `noindex` the route meanwhile." The route stays
    built (D117: a path the build does not emit is a 404, and the band, the sitemap and the dead-path rule all
    read the built routes); only the crawler is told not to index an empty shelf. `404.astro` is the precedent
    for this attribute in this repo. */}
<Layout title="Past meetings - Matheapolis, a Minneapolis math club" noindex path="/past">
  <main class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="text-display-1 font-extrabold text-ink">Past meetings</h1>
    <p class="mt-2 text-lede leading-prose text-ink-2 mb-8 max-w-measure mx-auto">
      Every date on our own calendar that has finished and was not called off.
    </p>

    {/* Two states of one list, written as separate branches rather than one ternary over a fragment:
        the list branch renders nothing today (see the header), and an empty <ul> is a hole a reader
        pays for, so the notice branch is what ships and it must not sit inside the list. */}
    {win.total > 0 && (
      <ul class="mt-6 space-y-4 text-body leading-prose text-ink-2 font-body">
        {win.shown.map((row) => {
          const d = dateOf(row);
          return (
            <li data-surface="past-row" data-date={d}>
              <time class="tabular-nums" datetime={d}>{plainDate(d)}</time> — {publishedName(row)}
            </li>
          );
        })}
      </ul>
    )}
    {win.total > 0 && olderText && <p class="mt-4 text-label text-ink-3">{olderText}</p>}
    {win.total === 0 && (
      // The empty state in the shipped notice grammar (DESIGN.md "States", the same block `Schedule.astro`
      // chose in round 7): status word, title, one body line, one boundary. No date is printed here today,
      // which is what keeps `check:dated-surfaces` green for this surface: a ruled page with nothing to
      // list is a designed state, and a provenance date on it would be a second one.
      <div class="mt-6 max-w-measure">
        <div role="status" class="inset-shadow-rule rounded-control px-4 py-6">
          <p class="text-label font-medium text-ink-3">Nothing listed yet</p>
          <h2 class="mt-1 text-lede font-bold text-ink font-body">No finished date on our calendar</h2>
          <p class="mt-2 text-body leading-prose text-ink-2 font-body">{emptyBody}</p>
        </div>
      </div>
    )}

    <p class="mt-6 text-body leading-prose text-ink-2 max-w-measure mx-auto">
      The club posts every session on
      <a
        href={URLs.meetupGroup}
        target="_blank"
        rel="noopener noreferrer"
        class="underline text-ink-2 hover:text-accent"
      >its own Meetup page<span class="sr-only">{newTabQualifier('its own Meetup page', PLATFORMS.meetup)}</span></a
      >, and a meeting that has already happened lives there.
    </p>
    <p class="mt-4 text-label text-ink-3">
      <a
        href="/dates"
        class="underline text-ink-2 hover:text-accent"
      >The dates still to come</a
      > are the page of record.
    </p>
  </main>
  <Footer />
</Layout>
