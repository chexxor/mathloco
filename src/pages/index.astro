---
import HeroSection from '../components/HeroSection.astro';
import HorizonBand from '../components/HorizonBand.astro';
import Layout from '../layouts/Layout.astro';
import Schedule from '../components/Schedule.astro';
import WhyJoinUs from '../components/WhyJoinUs.astro';
import Footer from '../components/Footer.astro';
import { sections } from '../config.json';

// Nothing on this page is per-request: the technical flags are in src/config.json and the club's own
// facts - cadence, focus, dates, venue, member count - are in src/content.json (src/lib/content.ts says
// what to say when one is missing). The live Discord data is fetched by /chat's island. Prerendering
// makes the landing page a static asset (no worker CPU, no cold start) and lets the image service emit
// the hero's resized variants at build time instead of on first request.
export const prerender = true;
---

<Layout title='Matheapolis - a Minneapolis math club'>
  <HeroSection />
  <WhyJoinUs />
  <HorizonBand />
  {/* D306 (2026-11-14, superseding the date half of D227): the homepage prints NO date — `/schedule` is the only
      surface that does, and `check:dated-surfaces` fails any other page that prints one. What this band carries is
      the join mechanics D228 merged into it (heading, "How it works", the roster sentence and its age, the photo
      slot) plus a pointer at the page of record, and `limit={1}` still comes from the same `upcoming()` that
      `/schedule`'s rows and `/events.ics` read, so the count it prints cannot drift from the list behind it.
      `sections.showSchedule` gates this band only: turning it off hides the join mechanics and the pointer, and
      does not un-publish `/schedule`. */}
  {sections.showSchedule && <Schedule variant="compact" limit={1} />}
  <Footer />
</Layout>
