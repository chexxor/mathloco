---
import HeroSection from '../components/HeroSection.astro';
import HorizonBand from '../components/HorizonBand.astro';
import Layout from '../layouts/Layout.astro';
import Schedule from '../components/Schedule.astro';
import WhyJoinUs from '../components/WhyJoinUs.astro';
import Footer from '../components/Footer.astro';
import { sections } from '../config.json';

// Nothing on this page is per-request: the technical flags are in src/config.json and the club's own
// facts - cadence, focus, dates, venue, member count - are in src/content.json (src/lib/content.ts says
// what to say when one is missing). The live Discord data is fetched by /chat's island. Prerendering
// makes the landing page a static asset (no worker CPU, no cold start) and lets the image service emit
// the hero's resized variants at build time instead of on first request.
export const prerender = true;
---

<Layout title='Minneapolis Math Book Club'>
  <HeroSection />
  <WhyJoinUs />
  <HorizonBand />
  {/* D227: the homepage carries the ONE next date, not the calendar, and `limit={1}` is the whole split —
      the card's facts come from the same `upcoming()` the `/schedule` page's rows and `/events.ics` read, so
      no two surfaces can drift apart. D228: this one call is also the landing page's join band (its heading,
      "How it works", the two paths out), which used to be a separate `JoinCommunity.astro` section below the
      fold; it is the same band now, because a date and how you come to it are one question.
      `sections.showSchedule` gates this band only: turning it off hides the homepage's date and the join
      mechanics, and does not un-publish `/schedule`. */}
  {sections.showSchedule && <Schedule variant="compact" limit={1} />}
  <Footer />
</Layout>
