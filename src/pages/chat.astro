---
import Layout from '../layouts/Layout.astro';
import DiscordSummary from '../components/DiscordSummary.svelte';
import Footer from '../components/Footer.astro';
import ThreadFigure from '../components/ThreadFigure.astro';
import { threads } from '../lib/content.ts';
import config from '../config.json';
import { PLATFORMS } from '../lib/rsvp.mjs';
import { newTabQualifier } from '../lib/links.mjs';

// Nothing here is per-request: the island fetches /api/discord-summary in the browser, and the rest
// of the page is static markup. Prerendering turns /chat into a static asset (no Worker CPU, no cold
// start, edge-cacheable) - verified: `dist/client/chat/index.html` appears in the build output.
export const prerender = true;

// One place for the invite, because the island's empty and failed states need to offer the same
// path out that the CTA does (D108: a designed state names where the content lives) — and the footer
// band names the same destination. That one place is `URLs.discordInvite` in src/config.json.
const DISCORD_URL = config.URLs.discordInvite;
// The full thread list lives here (S042, read §5.4): the home page shows six and links "the rest of the
// list ->" to this page, so the cap does not delete anything. Same `threads()` call, same source in
// `src/content.json` - one data home, so the two pages cannot drift (the "one home per rule" rule).
const items = threads();
---

<Layout title="Chat - Matheapolis, a Minneapolis math club" path="/chat">
  <main class="mx-auto max-w-4xl px-4 py-8">
    {/* No eyebrow above the h1 (S040, second design read §1, 2026-11-14): the page's name is its h1, and the
        line under it says what the page holds. "Community Chat" above the heading was a locator the nav already
        supplies - `check:naming` (D309) holds nav, title, band and heading to one word, and the new rule in the
        same gate fails any text between `<main>` and the first heading. The air is unchanged: mb-4 + mb-8 is
        the same 48px the h1's mb-12 spent, and both steps are on DESIGN.md's ladder — `mb-10` (40px) was not,
        and `npm run check:scale` (S042, D321) now fails any spacing write off it. */}
    {/* Round-6 review (2026-11-16), `/chat`/Revise (D409): "The page is named for a thing that isn't on it."
        The h1 used to read "Summaries from the chat" and the section under it - the bot's reading - is what
        the server renders as a notice with nothing under it, so the page promised summaries it did not carry.
        The name now says what the page is: the club's chat. The bot keeps its own heading **inside the island**
        (see `DiscordSummary.svelte`), on the branch that has content under it, and the pending branch becomes
        a warm static state instead of a heading over a void (D409). `check:naming`'s `name-not-on-page` is
        still satisfied: the nav word is "Chat", and the h1 says it. The subtitle carries the page's three
        holdings in words rather than naming only the one section that may be empty, and it says them in words
        that do not restate the thread lead below it: `check:content`'s `near-duplicate-surface` fired on a
        subtitle sharing "where the club talks" with that lead, which is the same sentence of the same page
        printed in two surfaces (D273's rule: shared words across surfaces is a defect unless a ruling says the
        repeat is the point, and here it is not the point - the two lines answer different questions). */}
    <h1 class="text-display-1 font-extrabold text-ink mb-4">
      The club’s chat
    </h1>
    <p class="text-label uppercase tracking-wide text-ink-3 mb-8">The live channel, the threads worth reading, and the dates the club set</p>

    {/* A3 (round-5 communication read, 2026-11-16, D367): the page's ONE way out used to sit 1,720px down at
        1240 and y=2,075 at 390 — a phone visitor scrolled two screens of prose before reaching the only action
        `/chat` offers, which the read called the worst communication defect on the artifact. So the invite the
        page already owns moves UP into the first screen as a declared control: `data-control="secondary"`, the
        ratified secondary construction (paper fill, `inset-shadow-rule`, `text-label`, 48px — D139's single
        pressable step, D140's declared role), on `paper` and not inside a tinted card or a notice (D149-3c's
        one-boundary rule, which `check:render` enforces as "a notice contains a block action"). It reuses
        `config.URLs.discordInvite` — the one home for the invite, named in the comment above — so R1's ceiling
        moves from 2 outbound anchors outside the band to 3, under the cap of 6 that `check:rsvp-page` prints,
        and `check:ext-links` still sees a qualifier on it. The CTA below keeps its words and its role: this is
        the same path met earlier, which is why it is a secondary and not a second primary — "a band with two
        primaries has no primary" (Schedule.astro's own note). */}
    <div class="mt-8">
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-control="secondary"
        class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition"
      >
        Join the chat<span class="sr-only">{newTabQualifier('Join the chat', PLATFORMS.discord)}</span>
      </a>
    </div>

    <!-- `visible`, not `load`: the summary block is below the fold on phones, and this island
         drags in ~34 KB of Svelte runtime plus its own 3.8 KB. Hydrating on visibility leaves the
         server-rendered heading and the "Join the chat" CTA interactive immediately and skips
         the API fetch entirely for visitors who never scroll to it. -->
    <DiscordSummary client:visible discordUrl={DISCORD_URL} />

    {/* The threads, in full (S042). `id="threads"` is the anchor the home page's "the rest of the list ->"
        link points at; a link that lands on a page with no list is the D273 defect class, so the anchor and
        the list are added together, not one before the other. The rhythm is DESIGN.md's ruled one (8px row
        padding, 16px between rows, 32px between columns) and the two columns start at `md` (768px) - the
        read's 900px is not adopted as a new breakpoint because no gate here measures 900. */}
    {items.length > 0 && (
      <section class="mt-16 max-w-measure" id="threads" aria-labelledby="threads-heading">
        <h2 id="threads-heading" class="text-heading font-bold text-ink mb-4">What the club is pulling on</h2>
        {/* Round-6 review (2026-11-16), `/chat`/Remove (D411): "The duplicated thread list — this is the page's
            entire substance and it is word-for-word the home page's list, which home already calls 'the rest
            of the list →'. The destination must add something the teaser didn't."
            The **list stays** - `check:threads`'s `rest-link-missing` rule fails a home page that promises the
            rest of the list and a `/chat` that does not carry it, and the list is the answer to q24's neighbour
            question - and what changed is the lead. It used to restate what the home page already said
            ("the threads the home page lists, in full"), which is a teaser describing itself. The words here
            now name what this page adds over the teaser: every entry carries the club's own gloss (`src/content.json`
            threads `gloss`), and the drawing under the list is the one picture the site owns (S042, §6.6).
            No count is written here: `check:threads` reads the cap out of `WhyJoinUs.astro`'s `const VISIBLE`,
            and a second cap in this file would be a copy of a rule with two homes (D320). */}
        <p class="text-lede leading-prose text-ink-2 mb-6 font-body">
          Every thread on the list, each with what the club says it is, and the club's own drawing of one of
          them underneath. Any of them can be dropped mid-sentence, and none of them is a prerequisite for
          arriving.
        </p>
        <ul class="grid grid-cols-1 gap-x-8 md:grid-cols-2">
          {items.map(({ label, gloss }) => (
            <li class="py-2 text-body leading-prose font-body">
              <span class="font-semibold text-ink">{label}</span>
              {gloss && <span class="text-ink-2"> — {gloss}</span>}
            </li>
          ))}
        </ul>
        <ThreadFigure />
      </section>
    )}

    <div class="mt-16 bg-panel rounded-card p-8">
      <div class="text-center">
        <h2 class="text-heading font-bold text-ink mb-4">The chat itself</h2>
        <p class="text-lede leading-prose text-ink-2 mb-6 max-w-measure mx-auto">
          The summaries above are the bot's reading of the channel. The channel itself is where the club
          talks — what it is pulling on, what it is arguing about, where and when it is next meeting. The
          invite is the button below.
        </p>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-control="primary"
          class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition"
        >
          Join the chat<span class="sr-only">{newTabQualifier('Join the chat', PLATFORMS.discord)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </main>
  {/* Every page the build emits closes with the exit band (D115, enforced by check:page-exit). This page has
     one island and one CTA; without the band a visitor who arrives here from a shared link has the nav above
     and nothing below. */}
  <Footer />
</Layout>
