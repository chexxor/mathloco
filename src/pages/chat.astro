---
import Layout from '../layouts/Layout.astro';
import DiscordSummary from '../components/DiscordSummary.svelte';
import config from '../config.json';

// Nothing here is per-request: the island fetches /api/discord-summary in the browser, and the rest
// of the page is static markup. Prerendering turns /chat into a static asset (no Worker CPU, no cold
// start, edge-cacheable) - verified: `dist/client/chat/index.html` appears in the build output.
export const prerender = true;

// One place for the invite, because the island's empty and failed states need to offer the same
// path out that the CTA does (D108: a designed state names where the content lives) — and the footer
// band names the same destination. That one place is `URLs.discordInvite` in src/config.json.
const DISCORD_URL = config.URLs.discordInvite;
---

<Layout title="Discord Chat - Minneapolis Math Book Club">
  <main class="mx-auto max-w-4xl px-4 py-8">
    <div class="text-label uppercase tracking-wide mb-4">
      <span class="text-ink-3">Community Chat</span>
    </div>

    <h1 class="text-display-1 font-extrabold text-ink mb-12">
      Discord Chat Summary
    </h1>

    <!-- `visible`, not `load`: the summary block is below the fold on phones, and this island
         drags in ~34 KB of Svelte runtime plus its own 3.8 KB. Hydrating on visibility leaves the
         server-rendered heading and the "Join Discord Server" CTA interactive immediately and skips
         the API fetch entirely for visitors who never scroll to it. -->
    <DiscordSummary client:visible discordUrl={DISCORD_URL} />

    <div class="mt-16 bg-panel rounded-card p-8">
      <div class="text-center">
        <h2 class="text-heading font-bold text-ink mb-4">Join Our Community</h2>
        <p class="text-lede leading-prose text-ink-2 mb-6 max-w-measure mx-auto">
          Connect with fellow math enthusiasts, participate in discussions, and be part of our growing community. Our Discord server is a friendly space for mathematical exploration and learning.
        </p>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-control="primary"
          class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
        >
          Join Discord Server
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>
