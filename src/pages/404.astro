---
import Layout from '../layouts/Layout.astro';
import { URLs } from '../config.json';

// Cloudflare Pages serves the root page for any path that is not a static asset **unless a
// top-level `404.html` exists** ("If your project does not include a top-level `404.html` file,
// Pages assumes that you are deploying a single-page application", pages/configuration/serving-pages).
// Measured on the branch preview before this file existed: `/api/discord-summary` and
// `/definitely-not-a-page` both returned **200 + the home page**. This route makes Astro emit
// `dist/client/404.html`, which turns that soft-404 behaviour off.
export const prerender = true;
---

<Layout title="Page not found - Matheapolis" noindex>
  <main class="mx-auto max-w-4xl px-4 py-24 text-center">
    <p class="text-label uppercase tracking-wide mb-4">
      <span class="text-ink-3">404</span>
    </p>

    <h1 class="text-display-1 font-extrabold text-ink mb-6">We could not find that page</h1>

    <p class="text-lede leading-prose text-ink-2 mb-12 max-w-measure mx-auto">
      The link may be old, or the address may have a typo. Everything we have sits behind one of these
      links.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/"
        data-control="primary"
        class="inline-flex items-center justify-center px-8 py-4 text-label font-semibold rounded-control text-band-text bg-ink hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
      >
        Back to the home page
      </a>
      <a
        href="/chat"
        data-control="secondary"
        class="inline-flex items-center justify-center px-8 py-4 text-label font-medium rounded-control text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold transition"
      >
        Recent Discord summaries
      </a>
    </div>

    <p class="text-label text-ink-3 mt-16">
      Looking for a specific meetup?
      <a
        href="/schedule"
        class="underline text-ink-2 hover:text-gold"
      >Our schedule page</a
      > lists every date on the club’s own calendar, and
      <a
        href={URLs.meetupGroup}
        target="_blank"
        rel="noopener noreferrer"
        class="underline text-ink-2 hover:text-gold"
      >our Meetup group</a
      > lists every session.
    </p>
  </main>
</Layout>
