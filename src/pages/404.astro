---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import { URLs } from '../config.json';
import { PLATFORMS } from '../lib/rsvp.mjs';
import { newTabQualifier } from '../lib/links.mjs';

// Cloudflare Pages serves the root page for any path that is not a static asset **unless a
// top-level `404.html` exists** ("If your project does not include a top-level `404.html` file,
// Pages assumes that you are deploying a single-page application", pages/configuration/serving-pages).
// Measured on the branch preview before this file existed: `/api/discord-summary` and
// `/definitely-not-a-page` both returned **200 + the home page**. This route makes Astro emit
// `dist/client/404.html`, which turns that soft-404 behaviour off.
export const prerender = true;
---

<Layout title="Page not found - Matheapolis" noindex>
  {/* `py-16` (64px) rather than `py-24` (96px): DESIGN.md puts 64px at a page's own top and bottom edges,
     and 96 is not on the eight-step ladder. `check:scale` (S042, D321) is what found it — the page has no
     band air to measure against, so a spacing value nobody ruled survived here. */}
  <main class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="text-display-1 font-extrabold text-ink">We could not find that page</h1>
    {/* The status code is the subtitle, not a label above the heading (S040, 2026-11-14): `check:naming`
       now fails any text between `<main>` and the first heading, and a code under the sentence reads the way
       a printed page sets one. */}
    <p class="mt-2 text-label uppercase tracking-wide text-ink-3 mb-6">404</p>

    {/* MS41 (S090, D467): the two controls and the line above them become one declared context. The lede is what
        says what the page is offering, so it is inside the block rather than near it. The numbers this choice rests
        on are the research letter's: **17 of 49** actions had under 6 words inside their own enclosing block
        @measured 2026-11-20 by `node design/cta-inventory.mjs`; on this tree the same probe reads **6 of 45** on
        that measure and **0 of 45** on the **declared-block** measure `check:cta-context` enforces
        @measured 2026-11-21 by the same probe. The secondary keeps its shipped words (D140's 48px ladder record in
        `design/decisions.json` names this control by them).

        `gloss={false}` on both, and that is load-bearing, not terseness. The row below is
        `flex … gap-4 justify-center`: a `block={null}` call that asks for a gloss emits `<a>` + `<p>` as **two**
        children of that flex row, the row squeezes, and each label wraps to a second line — `check:render:dist` then
        measures those controls at **68.3px** at 1240 and **80px** at 640 against the ratified 48px step
        @measured 2026-11-21 by `npm run check:render:dist`. A context sentence belongs in the block, not between two
        controls. So the lede does the naming, and the gate is what proved it necessary: with the sentence in the
        control's mouth and not the block's, removing it left `check:cta-context` failing
        `block-names-no-destination` on this very control ("needs one of: chat, thread, threads, conversation")
        @measured 2026-11-21 by `npm run check:cta-context`. */}
    <div data-cta-block="home-page chat-page">
      <p class="text-lede leading-prose text-ink-2 mb-12 max-w-measure mx-auto">
        The link may be old, or the address may have a typo. Everything the club publishes sits behind two
        links: the home page, and the chat page, where you can see what the club has pulled on.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CallToAction
          id="home-page"
          role="primary"
          href="/"
          label="Back to the home page"
          gloss={false}
          block={null}
        />
        <CallToAction
          id="chat-page"
          role="secondary"
          href="/chat"
          label="Recent Discord summaries"
          gloss={false}
          block={null}
        />
      </div>
    </div>

    {/* The two paths for a reader who is looking for one date (MS41, S090): the sentence already names both
        destinations, so the sentence is declared as their block and the anchors only carry their ids. */}
    <p class="text-label text-ink-3 mt-16" data-cta-block="dates-page meetup-group">
      Looking for a specific meetup?
      <a
        href="/dates"
        data-cta="dates-page"
        class="underline text-ink-2 hover:text-accent"
      >Our dates page</a
      > lists every date on the club’s own calendar, and
      <a
        href={URLs.meetupGroup}
        data-cta="meetup-group"
        target="_blank"
        rel="noopener noreferrer"
        class="underline text-ink-2 hover:text-accent"
      >our Meetup group<span class="sr-only">{newTabQualifier('our Meetup group', PLATFORMS.meetup)}</span></a
      > lists every session.
    </p>
  </main>
  {/* The exit band on the not-found page too (D115, check:page-exit): the page already lists paths out, but a
     visitor who typed a wrong address is the one who most needs the band's schedule / chat / ways-in links and
     the identity line that says whose site they are on. */}
  <Footer />
</Layout>
