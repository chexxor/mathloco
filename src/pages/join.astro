---
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
import Footer from '../components/Footer.astro';
import { JOIN_KIND_COPY, joinChannels, paintedKinds } from '../lib/rsvp.mjs';

// One action on the homepage lands here (S033, D303): the page's job is the commitment decision — which
// KIND of relationship the visitor wants — so the rows are grouped by kind and the platforms are values
// inside a group, not the structure itself. `joinChannels()` owns the list, the labels and the clause each
// row carries; this file owns only their arrangement, so `src/lib/rsvp.mjs` stays the one home for which
// platforms the club has and where each one goes (D264, D118).
//
// No island, and the canonical order is the painted order (D304): the page's shape is the explanation, so
// it must not change under a returning visitor. The remembered platform still leads every per-date cluster
// on `/` and `/schedule` (D281) — that is a different question, asked on a different page.
export const prerender = true;

const channels = joinChannels(config.URLs);
const kinds = paintedKinds(channels);
// `JOIN_KIND_COPY` is a literal object in a `.mjs` module, so TypeScript narrows it to exactly the three keys
// it declares, while `kinds` is a `string[]`; indexing one with the other is `ts(7053)` at `astro check`. The
// annotation is the widest honest type - the literal is still key-checked where it is written (2026-11-14).
const copy: Record<string, { heading: string; line: string }> = JOIN_KIND_COPY;
// Exactly one filled control on the page: the club's own member list is the one channel a source names as
// the member list (src/content.json `membership.value`), so it leads, and every other channel is a 48px
// secondary — the same two heights DESIGN.md fixes (D139), no third tier.
const lead = channels[0];   // identity, not href: two channels may one day share a destination
---

<Layout title="Ways in - Matheapolis" path="/join">
  <main class="mx-auto max-w-4xl px-4 py-8">
    {/* The eyebrow is deleted rather than moved: this page's h1 is its name ("Ways in", the phrase the site
       is best at) and the paragraph under it is already the subtitle the read asks for. S040, second design
       read §1, 2026-11-14; `check:naming` now fails any text between `<main>` and the first heading. */}
    <h1 class="text-display-1 font-extrabold text-ink">Ways in</h1>

    <p class="mt-4 max-w-measure text-lede leading-prose text-ink-2 font-body">
      Each way in is a different kind of thing, and you only need one to start: somewhere to follow along,
      something to turn up to, or somebody to talk to.
    </p>

    {
      kinds.map((kind) => {
        const rows = channels.filter((c) => c.kind === kind);
        const id = `join-${kind}`;
        return (
          <section class="mt-12" aria-labelledby={id}>
            <h2 id={id} class="text-heading font-bold text-ink">
              {copy[kind].heading}
            </h2>
            <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{copy[kind].line}</p>
            <ul class="mt-6 flex flex-col gap-4">
              {rows.map((c) => (
                <li>
                  <a
                    href={c.href}
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener noreferrer' : undefined}
                    data-control={c === lead ? 'primary' : 'secondary'}
                    data-join-kind={c.kind}
                    data-join-platform={c.platform}
                    class={
                      c === lead
                        ? 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-band-text bg-ink hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                        : 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                    }
                  >
                    {c.label}{c.srOnly && <span class="sr-only">{c.srOnly}</span>}
                  </a>
                  {/* What the visitor gets. Every clause is the resolver's, and every clause has a source
                      named in `joinChannels()` — the member list (src/content.json), the public Facebook
                      group (S021/D280), the per-date page (S019/D273), the chat between meetings (the
                      homepage lede's own sentence). No cadence word, no headcount, no price (D92, D265). */}
                  <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{c.gives}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <section class="mt-12" aria-labelledby="join-what-we-do">
      <h2 id="join-what-we-do" class="text-heading font-bold text-ink">What we do</h2>
      {/* The two things the club actually runs, in the organizer's own terms from the calendar feed, and
          without a frequency word: "we gather … to work in parallel" and "study independently, side by
          side" are the study session's DESCRIPTION, and the social is the row's own title plus the
          homepage's "around a table in a coffee shop or a brewery". No dates here — `/schedule` paints
          them, and it is the only surface that does (D218). */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        A social: an afternoon around a table at a bakery or a coffee shop, with no agenda to prepare for.
        A study session: an evening working side by side on whatever each person is learning, with help
        when someone asks for it.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        The next ones are on the
        <a
          href="/schedule"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >schedule</a
        >.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="first-meeting">
      <h2 id="first-meeting" class="text-heading font-bold text-ink">Your first one</h2>
      {/* Sourced, and consolidated (round-4 brief §8, 2026-11-15, D344): this section used to carry the
          homepage's claims **in its own words**, because the pair were near-duplicates and `check:content` was
          reading them as one surface copying another. §8 settles it the other way: the reassurances move to the
          page a reader has already reached when they have decided to come, so the homepage's own words live here
          and the paraphrase that stood in for them is deleted rather than kept beside them. Nothing is added to
          the two claims and nothing is dropped: "none of them is a prerequisite for arriving" arrives with the
          thing it refers to named, since this page does not print the thread list. */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        Nothing to prepare and nothing to read first. Bring a question; you don't need a field. Come and
        listen if you would rather; no subject is assumed, no background is required, and none of the
        threads the chat runs is a prerequisite for arriving.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Want to ask something before you turn up? Somebody from the club reads
        <a
          href="/chat"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >the messages we post there</a
        >.
      </p>
      {/* A4 · q13 (round-5 communication read, 2026-11-16, D368): the phone visitor asks whether the page
          hands over something to call or tap more than once, and the artifact carries no `tel:` and no email
          on any route, so the honest answer was a gap nobody could see. Stated here in the form `/` already
          ships twice for q06 and q07 — the page naming, in its own words, the question it will not answer —
          which is what moves `node design/visitor-questions.mjs`'s q13 verdict from UNANSWERED to DECLINED.
          One sentence, 0 boxes, no link, no third party named: a contact this seat cannot ground would be an
          unsourced claim (D92), so the refusal is the whole of the answer. */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        The club has no front desk and no phone number; the chat is where you ask.
      </p>
      {/* B4 · q25 (round-5 communication read, 2026-11-16, D372): "how do I get to the venue?" was UNANSWERED
          on every route, because the artifact prints an address and prints no way to reach it. Both halves were
          measured before writing: the address string ships — `/schedule` row prose reads e.g. "Kowalski's Market,
          5327 Lyndale Avenue South, Minneapolis, Minnesota" — and no map host ships anywhere (`grep -o 'google.com/maps\|mapbox\|openstreetmap' dist/client/*.html` returns nothing @measured 2026-11-16), so the honest answer is words, not a link. The venue changes with the date — `src/content.json` `venues._rule` says the names are "the pool a date gets a place from" (operator, 2026-11-03) — which is why the site cannot name one door. This is option (b) of the read's B4, and it is placed LAST in the section a visitor reaches after they have decided to come: no `src/config.json` URL key, no map host, no link, no box, so `check:ext-links`, `check:join` and the sprite's platform set stay exactly as they are, and `/schedule`'s row keeps its single way out (D342). Option (a) — a per-row map link — is the costly half: a platform this seat does not declare, and a second way out competing with D342's one inside the same row (D372). */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Every date names the place it is in and prints its street address, and that address is how you get
        there: the club meets in coffee shops, bakeries and breweries around the Twin Cities, so there is no
        single door this site could give directions to.
      </p>
    </section>

    {/* The legal pair, once, on the page that names the platforms (round-5 communication read A2, 2026-11-16,
        D366). It used to live in the exit band, which every emitted page ends with, so one fact pair printed
        TEN statements and the reader met it on `/404` too. `src/components/Footer.astro` now carries one
        clause beside the two platform names it paints; the sentences themselves are byte-identical to what
        the band used to print, and the attribution stays a static line rather than a component (round 10's
        ruling, quoted in DESIGN.md). No link and no box added, so R1's ceiling on outbound anchors and
        `check:page-exit` are untouched by this paragraph. */}
    <p class="mt-8 max-w-measure text-micro text-ink-3">
      Meetup and Discord are trademarks of their owners. This site is the club’s own — not sponsored or
      endorsed by either.
    </p>
  </main>
  {/* The exit band on the join page: the ways in are the whole subject of the page, so the band repeats the
     paths a reader reached by scrolling past them, and it is the same band every other emitted page carries
     (D115, check:page-exit). */}
  <Footer />
</Layout>
