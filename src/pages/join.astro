---
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
import Footer from '../components/Footer.astro';
import { JOIN_KIND_COPY, joinChannels, paintedKinds, PLATFORMS } from '../lib/rsvp.mjs';
import { answers, content, value } from '../lib/content.ts';
import { newTabQualifier } from '../lib/links.mjs';

// One action on the homepage lands here (S033, D303): the page's job is the commitment decision — which
// KIND of relationship the visitor wants — so the rows are grouped by kind and the platforms are values
// inside a group, not the structure itself. `joinChannels()` owns the list, the labels and the clause each
// row carries; this file owns only their arrangement, so `src/lib/rsvp.mjs` stays the one home for which
// platforms the club has and where each one goes (D264, D118).
//
// No island, and the canonical order is the painted order (D304): the page's shape is the explanation, so
// it must not change under a returning visitor. The remembered platform still leads every per-date cluster
// on `/` and `/schedule` (D281) — that is a different question, asked on a different page.
export const prerender = true;

const channels = joinChannels(config.URLs);
const kinds = paintedKinds(channels);
// `JOIN_KIND_COPY` is a literal object in a `.mjs` module, so TypeScript narrows it to exactly the three keys
// it declares, while `kinds` is a `string[]`; indexing one with the other is `ts(7053)` at `astro check`. The
// annotation is the widest honest type - the literal is still key-checked where it is written (2026-11-14).
const copy: Record<string, { heading: string; line: string }> = JOIN_KIND_COPY;
// Exactly one filled control on the page: the club's own member list is the one channel a source names as
// the member list (src/content.json `membership.value`), so it leads, and every other channel is a 48px
// secondary — the same two heights DESIGN.md fixes (D139), no third tier.
const lead = channels[0];   // identity, not href: two channels may one day share a destination
// Round-7 review (2026-11-18), `/join`/Add "The uneven bars named honestly" (D432). The review's point is a
// placement one: a study session is intimidating to the visitor who assumes everyone else at the table is
// further along, and the reassurance lives on neither surface they land on - it was in the calendar boilerplate
// and in `/join`'s format sentence. The sentence is an operator-granted DRAFT CLAIM in `src/content.json`
// (`studySessionShape`, with its `asOf` and its `correction` path, because D415 requires a grant-shipped claim
// to carry its way back and only a slot can), so the operator corrects the club's own words by editing that
// value rather than this page. Rendered on `/join` only, beside the format it describes.
const studyShape = value(content.studySessionShape);
// The operator's ruling of 2026-11-19 (the vision letter's answer for `/join`, and their ruling the same day
// that the pitch is carried **in place** rather than by a route the build does not emit — **S076**, **D450**).
// The letter asks for persuasion; a seat may not invent any, so the pitch is assembled from the claims the
// author already granted and this page already prints further down: what it costs (`cost`), whether you have
// to belong first (`membershipRule`), and how many people sit at the table (`turnout`). All three are slots in
// `src/content.json` with a named grant and a correction path (D381, D385), so the pitch carries no claim this
// tree cannot source, and the operator corrects any of it by editing a value rather than this page.
// Nothing new is typed here: the move is the round, not new copy.
const turnout = value(content.turnout);
---

<Layout title="Join the club - Matheapolis, a Minneapolis math club" path="/join">
  <main id="main" class="mx-auto max-w-4xl px-4 py-8">
    {/* The eyebrow is deleted rather than moved: this page's h1 is its name and the paragraph under it is
       already the subtitle the read asks for. S040, second design read §1, 2026-11-14; `check:naming` now
       fails any text between `<main>` and the first heading. (The h1 used to be "Ways in", the phrase the
       site is best at; D390 renamed it, and the phrase moved into the lede below — see the note there.) */}
    {/* Round-6 review (2026-11-16), `/join`/Revise (D390): "Ways in" is charming and on-voice, but it is not what
        a first-timer scans for, and `check:naming` (D309) requires the nav's word to appear in the page's opening
        block. The heading is now the word the nav carries - `Join` - and the phrase the site was best at moves
        into the lede, where it still does its work. Nav label, `<title>` and this h1 change in the same commit
        for the same reason: one name, four surfaces. */}
    <h1 class="text-display-1 font-extrabold text-ink">Join the club</h1>

    <p class="mt-4 max-w-measure text-lede leading-prose text-ink-2 font-body">
      Three ways in, and you only need one to start: come to a meeting, read the chat, or follow the club's feeds.
    </p>

    {/* The pitch, promoted (2026-11-19, **S076**, **D450**). The vision letter's answer for `/join` asked for a
        page that persuades the visitor joining is a good choice for them; the operator ruled the same day that
        this page carries that job instead of a sixth route. The answers below used to sit in "Your first one",
        which is where a reader who has already decided asks what they still have to do — the reasoning recorded
        in the note at that section, and it still holds for the room rules. It does not hold for these three
        claims: cost, who may come, and how many people are at the table are the questions a reader asks BEFORE
        choosing a door, and on this page they were 2/3 of the way down. They are painted from the same slots `/`
        paints them from (`answers()` is one call, `content.turnout` one value), so the two surfaces cannot be
        edited apart (D247's defect class, inverted), and the operator's own words are the wording (D381, D385).
        No sentence here is new copy.

        C1+C2 · q05 and q10 (round-5 communication read, 2026-11-16, D376/D377): these are the two club-claim gaps,
        and their history is the reason they are data. The read's own recommendation was the operator's word for
        each — a price, a membership rule — and both are claims about the club rather than about the page, which is
        why they are one-way and why the operator's letter of 2026-11-16 ruled instead that the gap is DECLINED
        here: no seat writes a fee, and no seat writes who may arrive. What shipped was therefore the page naming
        what it has never been told, and the only place it could say that from is the slot file: the two sentences
        come from `cost` and `membershipRule` in `src/content.json` through `answers()` (that name replaced
        `refusals()` on 2026-11-16, D381), which is the same call `/` paints them from, so the pair cannot be
        edited apart on one surface and left stale on the other (D247's defect class, inverted). Round-6 review,
        `/join`/Add (week item 1, D381) granted the answers, and both are corrected by editing `src/content.json`.
        They are NOT inside a channel row: the row's clause is the resolver's (`JOIN_KIND_COPY`, `joinChannels()`),
        it is text-pinned by `check:join`'s `join-gives-mismatch` rule, and a refusal inside a row would compete
        with D342's one way out. 0 boxes, no link, no URL, so `check:join`, `check:ext-links` and the sprite's
        platform set stay as measured. */}
    {answers().length > 0 && (
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">{answers().join(' ')}</p>
    )}
    {turnout && (
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">{turnout}</p>
    )}

    {/* Round-6 review, `/join`/Revise (D391): "What we do" moved from fourth to first. A visitor cannot choose a
        door into something they have not yet been told the thing is; the reviewer's peak-end point is the same
        one this repo already pays for in its nav (D309's one-name rule). The kinds below now run in ascending
        commitment - a date, a chat, a feed - which is `src/lib/rsvp.mjs`'s `CHANNEL_KINDS` order, and
        `scripts/check-join-page.mjs`'s `join-order` rule reads that same list rather than a remembered one. */}
    {/* MS41 (S090, D467): this section is the declared context block (`data-cta-block`) for the one pointer it ends
        with, and `data-cta` on the anchor names which registry row it answers (`scripts/check-cta-context.mjs` reads
        both off the built artifact). The section is the honest unit: "the next one" is meaningless without the two
        shapes of meeting this section spends three sentences describing, and a block around the eleven-word pointer
        alone measures 5 words beside the label - under `CTA_BLOCK_MIN_WORDS` (6), which is the rule doing its work:
        a pointer that names nothing is the defect this milestone deletes, not a smaller version of the fix. No copy
        changes, so `check:content`'s near-duplicate rule and `check:join-page`'s byte comparisons stay as measured. */}
    <section class="mt-12" aria-labelledby="join-what-we-do" data-cta-block="dates-page">
      <h2 id="join-what-we-do" class="text-heading font-bold text-ink">What we do</h2>
      {/* The two things the club actually runs, in the organizer's own terms from the calendar feed, and
          without a frequency word: "we gather … to work in parallel" and "study independently, side by
          side" are the study session's DESCRIPTION, and the social is the row's own title plus the
          homepage's "around a table in a coffee shop or a brewery". No dates here — `/dates` paints
          them, and it is the only surface that does (D218). */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        A social: an afternoon around a table at a bakery or a coffee shop, with no agenda to prepare for.
        A study session: an evening working side by side on whatever each person is learning, with help
        when someone asks for it.
      </p>
      {/* Round-7 review (2026-11-18), `/join`/Add (D432): the uneven bars, named. The review called this "the
          fix that converts the most common reason to not come" - a visitor who assumes the rest of the table is
          further along than they are reads "working side by side" as an invitation to be outperformed. Placed
          under the format sentence because it is that sentence's reassurance, and sourced from the slot rather
          than typed here because the words are the reviewer's draft, not a fact this tree can read (D415's
          rule, the same shape D381 and D385 paid for the cost line and the membership line). */}
      {studyShape && (
        <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">{studyShape}</p>
      )}
      {/* The operator deleted this sentence on 2026-11-19 (**D451**): "Just remove "Whether the room is your kind
        of room is not something a page can tell you.", then. I don't like that sentence." It had run since
        2026-11-16, when **D389** moved it off the closing line of `/` onto this page, and before that it closed the
        homepage. **D368**'s rule - name a gap the site cannot fill, in the open - is not withdrawn; this sentence
        was one of its two surviving examples, so the site now names **one** gap in the open (`/`'s "no syllabus, no
        reading list, no current focus") and `node design/visitor-questions.mjs` moves q07, "is the room one I can
        be in?", from DECLINED to UNANSWERED: deleting a refusal does not answer a question, it only removes the
        page's way of saying it cannot. MS32's photograph remains the real answer to q07, and the reviewer's own
        condition still holds - a room the reader can see. Nothing replaces the sentence: a fresh clause about the
        people or the group would be a claim with no hand behind it (**D92**), so this round typed no copy, which is
        what **S076** obliges. */}
      {/* Round-8 review (2026-11-18), `/join` copy line on line 21: "'The next ones are on the[dates page](/dates).'
          → 'Next: Sat, Nov 21, noon — [all the dates](/dates).'" — the letter's fix names the date so the pointer
          becomes the answer. What ships here is the pointer rewritten and NOT the date: `/join` printing a date
          fails two gates this tree will not contradict — `scripts/check-join-page.mjs`'s rule 1c (`join-date-painted`,
          "`/dates` is where dates live (D218's page of record…); a join page that repeats one goes stale on its
          own") and `scripts/check-dated-surfaces.mjs`, whose `RULED` map names `/dates`, `/past` and `/` only, so
          a fourth date-bearing surface fails `dated-surface-unruled`. Both rules trace to the operator's own
          `/join` objective ("no page grows a second source of truth for links, dates or claims"), and editing a
          gate script is outside this item's `src/` fence. So the vague phrase — "the next ones", which makes a
          reader leave to find out what it names — is what dies, and the sentence now says what the page it points
          at does. The date the reader wants is on that page, one click away, stated from the same window call.
          The decline and the ask that would ship it are rows J3 and J4 in the reply doc, and its §8 item 5. */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        The <a
          href="/dates"
          data-cta="dates-page"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >dates page</a
        > names the next one.
      </p>
    </section>

    {
      kinds.map((kind) => {
        const rows = channels.filter((c) => c.kind === kind);
        const id = `join-${kind}`;
        // MS41 (S090, D467): the kind section declares itself the context block for every destination its rows lead
        // to, because the section is the unit that explains what the row is a way into - the heading names the kind
        // of relationship, the line under it names what the club runs, and each row's clause names what the visitor
        // gets. A row with a clause (`gives`) narrows the block to itself below; a row with NO clause (the Discord
        // invite, whose clause the operator deleted on 2026-11-19, S079/D453) falls through to this section, which is
        // why `JOIN_KIND_COPY.chat.line` now says "server": `CALL_TO_ACTION['discord-server'].noun` requires the
        // block to name what the invite enrols you in, and an invite that never says so hides the half-disc
        // (Discord's own Invite Object, @retrieved 2026-11-20 from
        // https://discord.com/developers/docs/resources/invite).
        // A JSX `{/* */}` comment cannot go where this one wanted to live: inside `return (` it parses as a block
        // statement, and the build dies on the next attribute with "Expected `,` or `)` but found `class`".
        return (
          <section
            class="mt-12"
            aria-labelledby={id}
            data-cta-block={rows.map((c) => c.cta).filter(Boolean).join(' ')}
          >
            <h2 id={id} class="text-heading font-bold text-ink">
              {copy[kind].heading}
            </h2>
            <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{copy[kind].line}</p>
            <ul class="mt-6 flex flex-col gap-4">
              {rows.map((c) => {
                // The row declares its own block when it carries a clause of its own - the tightest honest unit of
                // context, and the one `check:join-page` already byte-pins to the resolver. When `gives` is empty the
                // `<li>` declares nothing at all, so the walker in `design/cta-rules.mjs` resolves the row's context
                // from the section above; a label-plus-new-tab-boilerplate block is exactly the air-around-a-label
                // this milestone deletes, so it must not be declared into existence. (Line comment, for the same
                // reason as the one above: `(c) => (` is expression position, and a JSX comment there is a syntax error.)
                return (
                  <li data-cta-block={c.gives ? c.cta : undefined}>
                  <a
                    href={c.href}
                    data-cta={c.cta}
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener noreferrer' : undefined}
                    data-control={c === lead ? 'primary' : 'secondary'}
                    data-join-kind={c.kind}
                    data-join-platform={c.platform}
                    class={
                      c === lead
                        ? 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-band-text bg-ink hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                        : 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                    }
                  >
                    {c.label}{c.srOnly && <span class="sr-only">{c.srOnly}</span>}
                  </a>
                  {/* What the visitor gets. Every clause is the resolver's, and every clause has a source
                      named in `joinChannels()` — the member list (src/content.json), the public Facebook
                      group (S021/D280), the per-date page (S019/D273). No cadence word, no headcount, no price
                      (D92, D265). A row may now carry **no** clause: the operator deleted the Discord row's
                      "The conversation that runs between meetings." on 2026-11-19 (**S079**, **D453**) — it was
                      one of the four sentences `npm run check:copy-contract --print-hollow` held on the worklist,
                      and the author ruled all four go. So the clause is painted only when the resolver carries one,
                      rather than leaving an empty paragraph in the row. `check:join-page`'s `join-gives-mismatch`
                      reads the row's last `<p>` and compares it with the resolver byte for byte, so "no `<p>`" and
                      "an empty clause" are the same record: both ''. */}
                  {c.gives && <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{c.gives}</p>}
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })
    }

    <section class="mt-12" aria-labelledby="first-meeting">
      <h2 id="first-meeting" class="text-heading font-bold text-ink">Your first one</h2>
      {/* Round-6 review (2026-11-16), `/join`/Revise + Home/Add (D392, D388): one 60-word paragraph with four
          negations becomes three short rules, in the order a person actually walks through them - what happens,
          what to bring, what is expected. The reviewer's point is a reading-theory one: a prediction is faster to
          parse and more memorable than a reassurance, and peers make the first ten minutes a scheduled thing
          (parkrun's "just turn up") instead of a disclaimer. The coffee line and the turnout figure are
          operator-granted draft claims (D381, D385) - the coffee line is written here because it is a rule of the
          room rather than a fact with a source file; `check:content`'s open-slot report is untouched.
          D344's consolidation survives: the homepage's no-syllabus line stays in the hero and these three rules
          are on a different built page, so the two surfaces cannot drift into a duplicate the gate would flag. */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        Walk in, find a table, buy a coffee if you want one — that is the rent.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Bring nothing.
      </p>
      {/* Round-8 review (2026-11-18), `/join` Remove "delete the second sentence of line 58 ('There is nothing
          to prepare…'); home already says it." The pair is D344's and D369's registered deliberate duplicate
          across the two surfaces — the home hero states the reassurance on the surface that says what a meeting
          is, and this page restated it. Deleting the `/join` half leaves it on the surface that owns it, which is
          what a duplicate is for. The rule of the room stays: "Bring nothing." is the shortest of the three and
          the one a reader acts on. */}
      {/* Round-8 review (2026-11-18), `/join` copy line on line 60: "'Expect nothing.' → 'Nothing is expected
          of you.'" — the two-word imperative reads as a command barked at a stranger; the sentence that answers
          "what do I have to do" is the one with a subject in it. The clause after it is the letter's Keep of the
          same row and stays byte for byte. */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Nothing is expected of you. People work on what they brought, and nobody sets an agenda.
      </p>

      {/* The cost answer and the membership answer used to close this section, beside the page's other refusals,
          because this is where a reader who has already decided asks what they still have to do. They moved to the
          opening block on 2026-11-19 (**S076**, **D450**) when the operator ruled that this page carries the pitch;
          their provenance travels with them, above the lede. The RSVP instruction still reaches the reader who has
          decided from the "Come to a meeting" row, whose clause is the resolver's — "Where the club announces
          dates, and keeps the RSVP list." */}
      {/* Round-6 review, `/join`/Remove (D393): "The club has no front desk and no phone number" comes off the
        page. D368 wrote it because the artifact carried no `tel:` and no address, and the reviewer's verdict is
        that a list of what the club does not have is institutional absence dressed as honesty - the same class
        the round-5 read called a DECLINED answer and this round calls a defect. q13's answer is now the chat
        path itself (the page already says "somebody from the club reads the messages we post there"), so the
        negation is not needed to make the question answerable. The mailto the review asked for is declined with evidence (D403): `dig +short MX matheapolis.com`
        and `dig +short MX minneapolismathbookclub.com` each returned no record at all @measured 2026-11-17
        (Linux native), so neither zone carries an address service and printing one would invent it. The trigger
        that ships the mailto is written in the reply doc: the day the operator provisions Cloudflare Email
        Routing on the apex zone. The sentence below still carries that path in words, so D393's half of the
        deletion (the negation) survives; only the door it lands on moved, in round 7 - see the note there.
      */}
      {/* MS41 (S090, D467): the sentence already promised "a place to ask", so it is the block this control's
          context lives in, and the declared block makes that promise checkable instead of a claim about the prose. The label
          gains "server" for one reason: `CALL_TO_ACTION['discord-server'].noun` is `server`, and the research
          (`docs/research/discord-invite-ux-2026-11-20.md`) bought that word from Discord's own docs - an invite is
          "a code that when used, adds a user to a guild" @retrieved 2026-11-20 from
          https://discord.com/developers/docs/resources/invite. "the club's Discord" names the platform; "server +
          invite + joins" names what the click does to the visitor. That clause is a delegate draft and sits on the
          operator's ToDo with the rest of the round's copy. */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body" data-cta-block="discord-server">
        Want to ask something before you turn up? Somebody from the club reads the channel, and the place to
        ask is{' '}
        {/* Round-7 review (2026-11-18), `/join`/Revise, the "broken door" (D432). The letter's read is exact:
            the anchor promised a place to ask and landed on `/chat`, which is machine summaries you cannot
            ask a question on. The letter offers two doors and only one is available here - the mailto is
            declined with evidence (D403, and the operator confirmed on 2026-11-18 that no address is
            provisioned), so this points at the invite, where a question can actually be typed. The URL is
            `config.URLs.discordInvite`, the one home the invite has (chat.astro names it too), so `/join`
            cannot be edited apart from the band and the card. The label names the platform, so `newTabQualifier`
            adds only the mode (S041); no `data-rsvp-platform` here, because `check-rsvp-preference` counts one
            per route and this is prose, not a band exit. */}
        <a
          href={config.URLs.discordInvite}
          data-cta="discord-server"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >the club&#x2019;s Discord server<span class="sr-only">{newTabQualifier('the club\u2019s Discord server', PLATFORMS.discord)}</span></a
        > — the invite joins you to it.
      </p>
      {/* Round-6 review, `/join`/Remove (D393): the directions paragraph leaves the page. q25's answer is the
        street address the row itself prints, and `/dates` carries that sentence (D372); on `/join` the sentence
        was about the site's inability to draw a route. The address claim survives where the address is painted.
        The legal line leaves the body too: it goes to the band's colophon, which is where a legal line belongs
        (the reviewer's peak-end point, and D366's split is superseded by D394). */}
    </section>
  </main>
  {/* The exit band on the join page: the ways in are the whole subject of the page, so the band repeats the
     paths a reader reached by scrolling past them, and it is the same band every other emitted page carries
     (D115, check:page-exit). */}
  <Footer />
</Layout>
