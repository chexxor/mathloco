---
import Layout from '../layouts/Layout.astro';
import config from '../config.json';
import Footer from '../components/Footer.astro';
import { JOIN_KIND_COPY, joinChannels, paintedKinds, PLATFORMS } from '../lib/rsvp.mjs';
import { answers, content, value } from '../lib/content.ts';
import { newTabQualifier } from '../lib/links.mjs';

// One action on the homepage lands here (S033, D303): the page's job is the commitment decision — which
// KIND of relationship the visitor wants — so the rows are grouped by kind and the platforms are values
// inside a group, not the structure itself. `joinChannels()` owns the list, the labels and the clause each
// row carries; this file owns only their arrangement, so `src/lib/rsvp.mjs` stays the one home for which
// platforms the club has and where each one goes (D264, D118).
//
// No island, and the canonical order is the painted order (D304): the page's shape is the explanation, so
// it must not change under a returning visitor. The remembered platform still leads every per-date cluster
// on `/` and `/schedule` (D281) — that is a different question, asked on a different page.
export const prerender = true;

const channels = joinChannels(config.URLs);
const kinds = paintedKinds(channels);
// `JOIN_KIND_COPY` is a literal object in a `.mjs` module, so TypeScript narrows it to exactly the three keys
// it declares, while `kinds` is a `string[]`; indexing one with the other is `ts(7053)` at `astro check`. The
// annotation is the widest honest type - the literal is still key-checked where it is written (2026-11-14).
const copy: Record<string, { heading: string; line: string }> = JOIN_KIND_COPY;
// Exactly one filled control on the page: the club's own member list is the one channel a source names as
// the member list (src/content.json `membership.value`), so it leads, and every other channel is a 48px
// secondary — the same two heights DESIGN.md fixes (D139), no third tier.
const lead = channels[0];   // identity, not href: two channels may one day share a destination
// Round-7 review (2026-11-18), `/join`/Add "The uneven bars named honestly" (D432). The review's point is a
// placement one: a study session is intimidating to the visitor who assumes everyone else at the table is
// further along, and the reassurance lives on neither surface they land on - it was in the calendar boilerplate
// and in `/join`'s format sentence. The sentence is an operator-granted DRAFT CLAIM in `src/content.json`
// (`studySessionShape`, with its `asOf` and its `correction` path, because D415 requires a grant-shipped claim
// to carry its way back and only a slot can), so the operator corrects the club's own words by editing that
// value rather than this page. Rendered on `/join` only, beside the format it describes.
const studyShape = value(content.studySessionShape);
---

<Layout title="Join the club - Matheapolis, a Minneapolis math club" path="/join">
  <main class="mx-auto max-w-4xl px-4 py-8">
    {/* The eyebrow is deleted rather than moved: this page's h1 is its name and the paragraph under it is
       already the subtitle the read asks for. S040, second design read §1, 2026-11-14; `check:naming` now
       fails any text between `<main>` and the first heading. (The h1 used to be "Ways in", the phrase the
       site is best at; D390 renamed it, and the phrase moved into the lede below — see the note there.) */}
    {/* Round-6 review (2026-11-16), `/join`/Revise (D390): "Ways in" is charming and on-voice, but it is not what
        a first-timer scans for, and `check:naming` (D309) requires the nav's word to appear in the page's opening
        block. The heading is now the word the nav carries - `Join` - and the phrase the site was best at moves
        into the lede, where it still does its work. Nav label, `<title>` and this h1 change in the same commit
        for the same reason: one name, four surfaces. */}
    <h1 class="text-display-1 font-extrabold text-ink">Join the club</h1>

    <p class="mt-4 max-w-measure text-lede leading-prose text-ink-2 font-body">
      Three ways in, and you only need one to start: come to a meeting, read the chat, or follow the club's feeds.
    </p>

    {/* Round-6 review, `/join`/Revise (D391): "What we do" moved from fourth to first. A visitor cannot choose a
        door into something they have not yet been told the thing is; the reviewer's peak-end point is the same
        one this repo already pays for in its nav (D309's one-name rule). The kinds below now run in ascending
        commitment - a date, a chat, a feed - which is `src/lib/rsvp.mjs`'s `CHANNEL_KINDS` order, and
        `scripts/check-join-page.mjs`'s `join-order` rule reads that same list rather than a remembered one. */}
    <section class="mt-12" aria-labelledby="join-what-we-do">
      <h2 id="join-what-we-do" class="text-heading font-bold text-ink">What we do</h2>
      {/* The two things the club actually runs, in the organizer's own terms from the calendar feed, and
          without a frequency word: "we gather … to work in parallel" and "study independently, side by
          side" are the study session's DESCRIPTION, and the social is the row's own title plus the
          homepage's "around a table in a coffee shop or a brewery". No dates here — `/dates` paints
          them, and it is the only surface that does (D218). */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        A social: an afternoon around a table at a bakery or a coffee shop, with no agenda to prepare for.
        A study session: an evening working side by side on whatever each person is learning, with help
        when someone asks for it.
      </p>
      {/* Round-7 review (2026-11-18), `/join`/Add (D432): the uneven bars, named. The review called this "the
          fix that converts the most common reason to not come" - a visitor who assumes the rest of the table is
          further along than they are reads "working side by side" as an invitation to be outperformed. Placed
          under the format sentence because it is that sentence's reassurance, and sourced from the slot rather
          than typed here because the words are the reviewer's draft, not a fact this tree can read (D415's
          rule, the same shape D381 and D385 paid for the cost line and the membership line). */}
      {studyShape && (
        <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">{studyShape}</p>
      )}
      {/* Round-6 review, Home/Remove (D389): the sentence the homepage used to close with lives here now, on the
        page a reader reaches after they have decided. It is the site naming its own limit honestly, and it is
        not the last thing on the page. Its trigger for deletion is the MS32 photograph: a room the reader can
        see makes the sentence unnecessary (the reviewer's own condition). */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Whether the room is your kind of room is not something a page can tell you.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        The next ones are on the
        <a
          href="/dates"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >dates page</a
        >.
      </p>
    </section>

    {
      kinds.map((kind) => {
        const rows = channels.filter((c) => c.kind === kind);
        const id = `join-${kind}`;
        return (
          <section class="mt-12" aria-labelledby={id}>
            <h2 id={id} class="text-heading font-bold text-ink">
              {copy[kind].heading}
            </h2>
            <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{copy[kind].line}</p>
            <ul class="mt-6 flex flex-col gap-4">
              {rows.map((c) => (
                <li>
                  <a
                    href={c.href}
                    target={c.external ? '_blank' : undefined}
                    rel={c.external ? 'noopener noreferrer' : undefined}
                    data-control={c === lead ? 'primary' : 'secondary'}
                    data-join-kind={c.kind}
                    data-join-platform={c.platform}
                    class={
                      c === lead
                        ? 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-band-text bg-ink hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                        : 'inline-flex items-center justify-center px-8 py-4 rounded-control text-label font-semibold text-ink bg-paper inset-shadow-rule hover:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition'
                    }
                  >
                    {c.label}{c.srOnly && <span class="sr-only">{c.srOnly}</span>}
                  </a>
                  {/* What the visitor gets. Every clause is the resolver's, and every clause has a source
                      named in `joinChannels()` — the member list (src/content.json), the public Facebook
                      group (S021/D280), the per-date page (S019/D273), the chat between meetings (the
                      homepage lede's own sentence). No cadence word, no headcount, no price (D92, D265). */}
                  <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">{c.gives}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <section class="mt-12" aria-labelledby="first-meeting">
      <h2 id="first-meeting" class="text-heading font-bold text-ink">Your first one</h2>
      {/* Round-6 review (2026-11-16), `/join`/Revise + Home/Add (D392, D388): one 60-word paragraph with four
          negations becomes three short rules, in the order a person actually walks through them - what happens,
          what to bring, what is expected. The reviewer's point is a reading-theory one: a prediction is faster to
          parse and more memorable than a reassurance, and peers make the first ten minutes a scheduled thing
          (parkrun's "just turn up") instead of a disclaimer. The coffee line and the turnout figure are
          operator-granted draft claims (D381, D385) - the coffee line is written here because it is a rule of the
          room rather than a fact with a source file; `check:content`'s open-slot report is untouched.
          D344's consolidation survives: the homepage's no-syllabus line stays in the hero and these three rules
          are on a different built page, so the two surfaces cannot drift into a duplicate the gate would flag. */}
      <p class="mt-2 max-w-measure text-body leading-prose text-ink-2 font-body">
        Walk in, find a table, buy a coffee if you want one — that is the rent.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Bring nothing. There is nothing to prepare and no reading to keep up with.
      </p>
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Expect nothing. People work on what they brought, and nobody sets an agenda.
      </p>

      {/* C1+C2 · q05 and q10 (round-5 communication read, 2026-11-16, D376/D377): the two club-claim gaps, in
          the open. The read's own recommendation was the operator's word for each — a price, a membership rule —
          and both are claims about the club rather than about the page, which is why they are one-way and why the
          operator's letter of 2026-11-16 ruled instead that the gap is DECLINED here: no seat writes a fee, and no
          seat writes who may arrive. What ships is therefore the page naming what it has never been told, and the
          only place it can say that from is the slot file: the two sentences come from `cost` and `membershipRule`
          in `src/content.json` through `refusals()`, which is the same call `/` paints them from, so the pair cannot
          be edited apart on one surface and left stale on the other (D247's defect class, inverted). Placed with the
          page's other refusals — the phone line and the directions words — because this section is "Your first one",
          which is where a reader who has already decided to come asks what they still have to do; the read preferred
          a clause on the "Come to a meeting" rows, but that clause is the resolver's (`JOIN_KIND_COPY` and
          `joinChannels()`), it is text-pinned by `check:join-page`'s `join-gives-mismatch` rule, and a refusal inside
          a row would compete with D342's one way out. 0 boxes, no link, no URL, so `check:join`, `check:ext-links`
          and the sprite's platform set stay as measured. */}
      {/* Round-6 review, `/join`/Add (week item 1, D381): the cost line and the membership line, in one
          paragraph, from the same two slots `/` paints them from, so the answer a stranger gets on the home page
          and the answer they get here are the same bytes. Both are draft claims granted by the operator on
          2026-11-16 and both are corrected by editing `src/content.json`. */}
      {answers().length > 0 && (
        <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">{answers().join(' ')}</p>
      )}

      {/* Round-6 review, `/join`/Remove (D393): "The club has no front desk and no phone number" comes off the
        page. D368 wrote it because the artifact carried no `tel:` and no address, and the reviewer's verdict is
        that a list of what the club does not have is institutional absence dressed as honesty - the same class
        the round-5 read called a DECLINED answer and this round calls a defect. q13's answer is now the chat
        path itself (the page already says "somebody from the club reads the messages we post there"), so the
        negation is not needed to make the question answerable. The mailto the review asked for is declined with evidence (D403): `dig +short MX matheapolis.com`
        and `dig +short MX minneapolismathbookclub.com` each returned no record at all @measured 2026-11-17
        (Linux native), so neither zone carries an address service and printing one would invent it. The trigger
        that ships the mailto is written in the reply doc: the day the operator provisions Cloudflare Email
        Routing on the apex zone. The sentence below still carries that path in words, so D393's half of the
        deletion (the negation) survives; only the door it lands on moved, in round 7 - see the note there.
      */}
      <p class="mt-3 max-w-measure text-body leading-prose text-ink-2 font-body">
        Want to ask something before you turn up? Somebody from the club reads the channel, and the place to
        ask is{' '}
        {/* Round-7 review (2026-11-18), `/join`/Revise, the "broken door" (D432). The letter's read is exact:
            the anchor promised a place to ask and landed on `/chat`, which is machine summaries you cannot
            ask a question on. The letter offers two doors and only one is available here - the mailto is
            declined with evidence (D403, and the operator confirmed on 2026-11-18 that no address is
            provisioned), so this points at the invite, where a question can actually be typed. The URL is
            `config.URLs.discordInvite`, the one home the invite has (chat.astro names it too), so `/join`
            cannot be edited apart from the band and the card. The label names the platform, so `newTabQualifier`
            adds only the mode (S041); no `data-rsvp-platform` here, because `check-rsvp-preference` counts one
            per route and this is prose, not a band exit. */}
        <a
          href={config.URLs.discordInvite}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink underline decoration-rule underline-offset-2 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >the club&#x2019;s Discord<span class="sr-only">{newTabQualifier('the club\u2019s Discord', PLATFORMS.discord)}</span></a
        >.
      </p>
      {/* Round-6 review, `/join`/Remove (D393): the directions paragraph leaves the page. q25's answer is the
        street address the row itself prints, and `/dates` carries that sentence (D372); on `/join` the sentence
        was about the site's inability to draw a route. The address claim survives where the address is painted.
        The legal line leaves the body too: it goes to the band's colophon, which is where a legal line belongs
        (the reviewer's peak-end point, and D366's split is superseded by D394). */}
    </section>
  </main>
  {/* The exit band on the join page: the ways in are the whole subject of the page, so the band repeats the
     paths a reader reached by scrolling past them, and it is the same band every other emitted page carries
     (D115, check:page-exit). */}
  <Footer />
</Layout>
